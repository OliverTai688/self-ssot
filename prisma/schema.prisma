// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  PARTNER
  CLIENT
  
  @@map("user_role")
}

enum ProjectStatus {
  EXPLORING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
  
  @@map("project_status")
}

enum VisibilityType {
  INTERNAL_ONLY
  CLIENT_VISIBLE
  
  @@map("visibility_type")
}

/// 營運工作台的使用者設定分區。ORG 級設定另存於 OrganizationSetting。
enum SettingScope {
  BASIC
  PERSONAL

  @@map("setting_scope")
}

enum DeliverableStatus {
  DRAFT
  DELIVERED
  APPROVED
  
  @@map("deliverable_status")
}

enum ResearchThreadStatus {
  EXPLORING
  ACTIVE
  WRITING
  PUBLISHED
  PAUSED
  
  @@map("research_thread_status")
}

enum ResearchSourceType {
  PAPER
  BOOK
  ARTICLE
  CONFERENCE_RECORD
  WORKSHOP_RECORD
  MEETING_RECORD
  AUDIO_TRANSCRIPT
  INSTITUTION_REPORT
  DATASET
  WEBSITE
  PERSONAL_NOTE
  
  @@map("research_source_type")
}

enum SourceReliability {
  PRIMARY
  SECONDARY
  INFORMAL
  PERSONAL_OBSERVATION
  
  @@map("source_reliability")
}

enum WritingProjectType {
  PAPER
  CONFERENCE_PAPER
  PROPOSAL
  ESSAY
  POSTER
  PRESENTATION
  
  @@map("writing_project_type")
}

enum WritingProjectStatus {
  IDEA
  OUTLINE
  DRAFTING
  REVIEWING
  SUBMITTED
  
  @@map("writing_project_status")
}

enum ReviewPerspective {
  METHOD_REVIEWER
  THEORY_REVIEWER
  DOMAIN_EXPERT
  CRITICAL_REVIEWER
  FRIENDLY_MENTOR
  CONFERENCE_CHAIR
  JOURNAL_EDITOR
  
  @@map("review_perspective")
}

enum EventType {
  CONFERENCE
  WORKSHOP
  SEMINAR
  SUMMER_SCHOOL
  WEBINAR
  
  @@map("event_type")
}

enum ParticipationMode {
  SUBMIT_PAPER
  SUBMIT_POSTER
  ATTEND
  ASK_QUESTION
  NETWORKING
  
  @@map("participation_mode")
}

enum ProjectPhase {
  DISCOVERY
  PLANNING
  EXECUTION
  REVIEW
  MAINTENANCE

  @@map("project_phase")
}

enum ProjectHealth {
  GOOD
  WATCH
  RISK

  @@map("project_health")
}

enum ProjectPhaseNodeStatus {
  UPCOMING
  ACTIVE
  DONE

  @@map("project_phase_node_status")
}

enum ProjectMilestoneStatus {
  UPCOMING
  COMPLETED

  @@map("project_milestone_status")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED

  @@map("task_status")
}

enum TaskSource {
  MANUAL
  AI_SUGGESTED
  TRIAGE
  CLIENT_REQUEST

  @@map("task_source")
}

enum NoteSource {
  LINE
  EMAIL
  MEETING
  INTERNAL

  @@map("note_source")
}

enum NoteOrigin {
  AI
  MANUAL

  @@map("note_origin")
}

enum DeliverableNodeType {
  FOLDER
  FILE

  @@map("deliverable_node_type")
}

enum SourceProvider {
  MANUAL
  LOCAL_FILE
  URL
  RSS
  GOOGLE_DRIVE
  GOOGLE_DOCS
  GMAIL
  LINE
  TELEGRAM
  GITHUB_MARKDOWN

  @@map("source_provider")
}

enum SourceConnectionStatus {
  SETUP_REQUIRED
  ACTIVE
  PAUSED
  REVOKED
  ERROR
  ARCHIVED

  @@map("source_connection_status")
}

enum SourceAssetKind {
  DOCUMENT
  MESSAGE
  URL
  FILE
  NOTE
  DATASET
  THREAD
  RECORD

  @@map("source_asset_kind")
}

enum SourceAssetStatus {
  INBOX
  REVIEWING
  READY
  REJECTED
  DELETED

  @@map("source_asset_status")
}

enum AIWorkflowRunStatus {
  QUEUED
  RUNNING
  NEEDS_REVIEW
  COMPLETED
  FAILED
  CANCELLED

  @@map("ai_workflow_run_status")
}

enum AIWorkItemKind {
  RECOGNITION
  EXTRACTION
  ORGANIZATION
  CORRECTION
  PROPOSAL
  WRITE_INTENT
  AUDIT_REVIEW

  @@map("ai_work_item_kind")
}

enum AIWorkItemStatus {
  TODO
  IN_PROGRESS
  NEEDS_REVIEW
  DONE
  BLOCKED

  @@map("ai_work_item_status")
}

enum SourceProposalStatus {
  DRAFT
  OWNER_REVIEW
  CHANGES_REQUESTED
  APPROVED_FOR_WRITE_INTENT
  REJECTED
  ARCHIVED
  SUPERSEDED
  BLOCKED_HIGH_RISK

  @@map("source_proposal_status")
}

enum ModuleWriteIntentStatus {
  DRAFT
  OWNER_REVIEW
  APPROVED_FOR_MANUAL_APPLY
  APPLIED_MANUALLY
  REJECTED
  CANCELLED
  BLOCKED_HIGH_RISK

  @@map("module_write_intent_status")
}

enum SourceApprovalLevel {
  AUTO_PROPOSE_ONLY
  OWNER_REVIEW_REQUIRED
  HUMAN_APPROVAL_REQUIRED
  BLOCKED_UNTIL_PROOF_TARGET
  BLOCKED_HIGH_RISK

  @@map("source_approval_level")
}

enum SourceRetentionClass {
  EPHEMERAL
  STANDARD
  SENSITIVE
  DELETE_REQUESTED
  LEGAL_HOLD

  @@map("source_retention_class")
}

enum StorageProvider {
  CLOUDFLARE_R2
  SUPABASE_STORAGE

  @@map("storage_provider")
}

enum FileScanStatus {
  NOT_REQUIRED
  PENDING
  PASSED
  FAILED

  @@map("file_scan_status")
}

enum LibraryAssetVisibility {
  PRIVATE
  CLIENT_VISIBLE

  @@map("library_asset_visibility")
}


enum SkillScope {
  GLOBAL
  WORKSPACE
  PERSONAL

  @@map("skill_scope")
}

enum SkillStatus {
  ACTIVE
  ARCHIVED
  DRAFT

  @@map("skill_status")
}

enum WorkspaceType {
  PERSONAL
  TEAM

  @@map("workspace_type")
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("workspace_status")
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MEMBER
  GUEST

  @@map("workspace_member_role")
}

enum WorkspaceMembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
  REMOVED

  @@map("workspace_membership_status")
}

enum ProjectAccessMode {
  PRIVATE
  WORKSPACE_VISIBLE

  @@map("project_access_mode")
}

enum ProjectAccessRole {
  VIEWER
  COMMENTER
  EDITOR
  MANAGER

  @@map("project_access_role")
}

enum ProjectAccessGrantStatus {
  ACTIVE
  INACTIVE

  @@map("project_access_grant_status")
}

enum CollaborationInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("collaboration_invitation_status")
}

enum ProjectFeedbackTargetType {
  PROJECT
  TASK
  NOTE
  DELIVERABLE
  FILE
  MEDIA

  @@map("project_feedback_target_type")
}

enum ProjectFeedbackStatus {
  ACTIVE
  RESOLVED
  WITHDRAWN
  DELETED

  @@map("project_feedback_status")
}

enum ProjectMemoryCandidateStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
  INVALIDATED

  @@map("project_memory_candidate_status")
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model Profile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId String?  @unique @map("auth_user_id") @db.Uuid
  email      String   @unique
  fullName   String?  @map("full_name")
  avatarUrl  String?  @map("avatar_url")
  role       UserRole @default(CLIENT)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  permissions     UserModulePermission[]
  projects        Project[]
  researchThreads ResearchThread[]
  sourceConnections SourceConnection[]
  sourceAssets SourceAsset[]
  aiWorkflowRuns AIWorkflowRun[]
  aiWorkItems AIWorkItem[]
  sourceNamingProfiles SourceNamingProfile[]
  dataUnitProposals DataUnitProposal[]
  moduleWriteIntents ModuleWriteIntent[] @relation("ModuleWriteIntentOwner")
  approvedModuleWriteIntents ModuleWriteIntent[] @relation("ModuleWriteIntentApprover")
  academicPeople AcademicPerson[]
  fileAssets FileAsset[]
  mediaAssets MediaAsset[]
  createdWorkspaces Workspace[] @relation("WorkspaceCreatedBy")
  workspaceMemberships WorkspaceMembership[] @relation("WorkspaceMembershipProfile")
  invitedWorkspaceMemberships WorkspaceMembership[] @relation("WorkspaceMembershipInvitedBy")
  sentCollaborationInvitations CollaborationInvitation[] @relation("CollaborationInvitationInvitedBy")
  acceptedCollaborationInvitations CollaborationInvitation[] @relation("CollaborationInvitationAcceptedBy")
  grantedProjectAccess ProjectAccessGrant[] @relation("ProjectAccessGrantGrantedBy")
  authoredProjectFeedback ProjectFeedback[] @relation("ProjectFeedbackAuthor")
  editedProjectFeedbackVersions ProjectFeedbackVersion[] @relation("ProjectFeedbackVersionEditor")
  reviewedProjectMemoryCandidates ProjectMemoryCandidate[] @relation("ProjectMemoryCandidateReviewer")

  createdSkills Skill[] @relation("SkillCreatedBy")
  operatingSettings UserSetting[] @relation("UserSettingProfile")
  updatedOrganizationSettings OrganizationSetting[] @relation("OrganizationSettingUpdatedBy")
  @@map("profiles")
}

model UserModulePermission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  moduleKey String   @map("module_key")
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([profileId, moduleKey])
  @@map("user_module_permissions")
}

model Project {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String            @map("owner_id") @db.Uuid
  owner       Profile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId String?           @map("workspace_id") @db.Uuid
  workspace   Workspace?        @relation("WorkspaceProjects", fields: [workspaceId], references: [id], onDelete: Restrict)
  accessMode  ProjectAccessMode @default(PRIVATE) @map("access_mode")
  name        String
  clientName  String?           @map("client_name")
  description String?
  status      ProjectStatus     @default(ACTIVE)
  phase       ProjectPhase      @default(PLANNING)
  health      ProjectHealth     @default(GOOD)
  visibility  VisibilityType    @default(INTERNAL_ONLY)
  clientToken String?           @map("client_token")
  startedAt   DateTime?         @map("started_at")
  dueAt       DateTime?         @map("due_at")
  nextAction  String?           @map("next_action")
  companyAxis String?           @map("company_axis")

  // ── 專案工作區五大資源（PLN-075 S2）───────────────────────────────────────
  /// 生命週期（提案→接案→執行→驗收→結案）。這四欄是新的權威來源，
  /// 但既有的 `status` / `phase` / `OperatingProjectProfile.operatingStatus`
  /// （獎金閘門③讀它）與 `ProjectDealStage`（金流推演讀它）一律原狀保留、不被覆寫。
  ///
  /// 既有列會拿到預設 `PROPOSING` —— 那對一個正在執行的專案是錯的。
  /// 在 S3 的回填把它算對之前，介面不得把這一欄當權威顯示（見 S2 證據報告）。
  lifecycleStage ProjectLifecycleStage @default(PROPOSING) @map("lifecycle_stage")
  /// 目前走到第幾期（`ProjectPhaseCycle.ordinal` 的快取）。null＝還沒分期。
  phaseRound     Int?              @map("phase_round")
  /// `0_工作區` 的兩位數資料夾編號。**不是鍵**：`09` 被用過兩次（編號會回收），
  /// 它只是「從舊硬碟找回同一個案子」的線索。
  legacyFolderNo String?           @map("legacy_folder_no")
  /// `0_工作區` 資料夾名稱的 `- N` 後綴，原樣存數字。Owner 2026-10-07 定義：
  /// 「主觀認為這個專案的重要程度」，**數字愈大愈重要**（5＝最高）。null＝未分級。
  priorityTier   Int?              @map("priority_tier")

  tasksDone   Int               @default(0) @map("tasks_done")
  tasksTotal  Int               @default(0) @map("tasks_total")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tasks        ProjectTask[]
  notes        ProjectNote[]
  deliverables ProjectDeliverable[]
  phaseNodes   ProjectPhaseNode[]
  contracts    OperatingContract[]  @relation("ProjectContracts")
  operatingProfile OperatingProjectProfile?
  occasions    Occasion[]           @relation("ProjectOccasions")
  collaborationInvitations CollaborationInvitation[] @relation("CollaborationInvitationProject")
  accessGrants ProjectAccessGrant[] @relation("ProjectAccessGrants")
  feedback ProjectFeedback[] @relation("ProjectFeedbackProject")
  memoryCandidates ProjectMemoryCandidate[] @relation("ProjectMemoryCandidateProject")

  folders      ProjectFolder[]      @relation("ProjectFolders")
  phaseCycles  ProjectPhaseCycle[]  @relation("ProjectPhaseCycles")
  chatChannels ProjectChatChannel[] @relation("ProjectChatChannels")
  chatMessages ProjectChatMessage[] @relation("ProjectChatMessages")

  @@index([workspaceId, status], map: "projects_workspace_status_idx")
  @@index([workspaceId, lifecycleStage], map: "projects_workspace_lifecycle_idx")

  @@map("projects")
}

model Workspace {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                     WorkspaceType
  name                     String
  slug                     String            @unique
  status                   WorkspaceStatus   @default(ACTIVE)
  defaultProjectAccessRole ProjectAccessRole @default(VIEWER) @map("default_project_access_role")
  aiFeedbackMemoryEnabled  Boolean           @default(false) @map("ai_feedback_memory_enabled")
  createdByProfileId       String            @map("created_by_profile_id") @db.Uuid
  createdBy                Profile           @relation("WorkspaceCreatedBy", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  memberships     WorkspaceMembership[]     @relation("WorkspaceMembershipWorkspace")
  invitations     CollaborationInvitation[] @relation("CollaborationInvitationWorkspace")
  projects        Project[]                 @relation("WorkspaceProjects")
  feedback        ProjectFeedback[]         @relation("ProjectFeedbackWorkspace")
  memoryCandidates ProjectMemoryCandidate[] @relation("ProjectMemoryCandidateWorkspace")

  skills          Skill[]                   @relation("WorkspaceSkills")

  @@index([status, type], map: "workspaces_status_type_idx")
  rhythms                  Rhythm[]          @relation("WorkspaceRhythms")
  occasions                Occasion[]        @relation("WorkspaceOccasions")
  timeSpine                TimeSpine[]       @relation("WorkspaceTimeSpine")

  @@map("workspaces")
}

model WorkspaceMembership {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String                    @map("workspace_id") @db.Uuid
  workspace          Workspace                 @relation("WorkspaceMembershipWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  profileId          String                    @map("profile_id") @db.Uuid
  profile            Profile                   @relation("WorkspaceMembershipProfile", fields: [profileId], references: [id], onDelete: Cascade)
  role               WorkspaceMemberRole       @default(MEMBER)
  status             WorkspaceMembershipStatus @default(ACTIVE)
  invitedByProfileId String?                   @map("invited_by_profile_id") @db.Uuid
  invitedBy          Profile?                  @relation("WorkspaceMembershipInvitedBy", fields: [invitedByProfileId], references: [id], onDelete: SetNull)
  joinedAt           DateTime?                 @map("joined_at")
  suspendedAt        DateTime?                 @map("suspended_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  projectGrants ProjectAccessGrant[] @relation("ProjectAccessGrantMembership")

  @@unique([workspaceId, profileId], map: "workspace_memberships_workspace_profile_unique")
  @@index([profileId, status], map: "workspace_memberships_profile_status_idx")
  @@map("workspace_memberships")
}

model CollaborationInvitation {
  id                  String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String                        @map("workspace_id") @db.Uuid
  workspace           Workspace                     @relation("CollaborationInvitationWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  normalizedEmail     String                        @map("normalized_email")
  tokenDigest         String                        @unique @map("token_digest")
  workspaceRole       WorkspaceMemberRole           @default(MEMBER) @map("workspace_role")
  projectId           String?                       @map("project_id") @db.Uuid
  project             Project?                      @relation("CollaborationInvitationProject", fields: [projectId], references: [id], onDelete: Restrict)
  projectRole         ProjectAccessRole?            @map("project_role")
  status              CollaborationInvitationStatus @default(PENDING)
  invitedByProfileId  String                        @map("invited_by_profile_id") @db.Uuid
  invitedBy           Profile                       @relation("CollaborationInvitationInvitedBy", fields: [invitedByProfileId], references: [id], onDelete: Restrict)
  acceptedByProfileId String?                       @map("accepted_by_profile_id") @db.Uuid
  acceptedBy          Profile?                      @relation("CollaborationInvitationAcceptedBy", fields: [acceptedByProfileId], references: [id], onDelete: Restrict)
  expiresAt           DateTime                      @map("expires_at")
  acceptedAt          DateTime?                     @map("accepted_at")
  revokedAt           DateTime?                     @map("revoked_at")
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")

  @@index([workspaceId, normalizedEmail, status], map: "collaboration_invitations_workspace_email_status_idx")
  @@index([expiresAt, status], map: "collaboration_invitations_expiry_status_idx")
  @@map("collaboration_invitations")
}

model ProjectAccessGrant {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId          String                   @map("project_id") @db.Uuid
  project            Project                  @relation("ProjectAccessGrants", fields: [projectId], references: [id], onDelete: Cascade)
  membershipId       String                   @map("membership_id") @db.Uuid
  membership         WorkspaceMembership      @relation("ProjectAccessGrantMembership", fields: [membershipId], references: [id], onDelete: Cascade)
  role               ProjectAccessRole
  status             ProjectAccessGrantStatus @default(ACTIVE)
  grantedByProfileId String                   @map("granted_by_profile_id") @db.Uuid
  grantedBy          Profile                  @relation("ProjectAccessGrantGrantedBy", fields: [grantedByProfileId], references: [id], onDelete: Restrict)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@unique([projectId, membershipId], map: "project_access_grants_project_membership_unique")
  @@index([membershipId, role, status], map: "project_access_grants_membership_role_status_idx")
  @@map("project_access_grants")
}

model ProjectFeedback {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                    @map("workspace_id") @db.Uuid
  workspace        Workspace                 @relation("ProjectFeedbackWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId        String                    @map("project_id") @db.Uuid
  project          Project                   @relation("ProjectFeedbackProject", fields: [projectId], references: [id], onDelete: Cascade)
  authorProfileId  String                    @map("author_profile_id") @db.Uuid
  author           Profile                   @relation("ProjectFeedbackAuthor", fields: [authorProfileId], references: [id], onDelete: Restrict)
  targetType       ProjectFeedbackTargetType @map("target_type")
  targetId         String?                   @map("target_id") @db.Uuid
  body             String
  status           ProjectFeedbackStatus     @default(ACTIVE)
  aiUseEligible    Boolean                   @default(false) @map("ai_use_eligible")
  aiUseReason      String?                   @map("ai_use_reason")
  currentVersion   Int                       @default(1) @map("current_version")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  deletedAt        DateTime?                 @map("deleted_at")

  versions         ProjectFeedbackVersion[] @relation("ProjectFeedbackVersions")

  @@index([workspaceId, projectId, status], map: "project_feedback_workspace_project_status_idx")
  @@index([authorProfileId, createdAt], map: "project_feedback_author_created_idx")
  @@map("project_feedback")
}

model ProjectFeedbackVersion {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId        String          @map("feedback_id") @db.Uuid
  feedback          ProjectFeedback @relation("ProjectFeedbackVersions", fields: [feedbackId], references: [id], onDelete: Cascade)
  version           Int
  body              String
  editedByProfileId String          @map("edited_by_profile_id") @db.Uuid
  editedBy          Profile         @relation("ProjectFeedbackVersionEditor", fields: [editedByProfileId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now()) @map("created_at")

  memoryCandidates ProjectMemoryCandidate[] @relation("ProjectMemoryCandidateFeedbackVersion")

  @@unique([feedbackId, version], map: "project_feedback_versions_feedback_version_unique")
  @@map("project_feedback_versions")
}

model ProjectMemoryCandidate {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String                       @map("workspace_id") @db.Uuid
  workspace           Workspace                    @relation("ProjectMemoryCandidateWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId           String                       @map("project_id") @db.Uuid
  project             Project                      @relation("ProjectMemoryCandidateProject", fields: [projectId], references: [id], onDelete: Restrict)
  feedbackId          String                       @map("feedback_id") @db.Uuid
  feedbackVersion     Int                          @map("feedback_version")
  feedbackVersionRecord ProjectFeedbackVersion    @relation("ProjectMemoryCandidateFeedbackVersion", fields: [feedbackId, feedbackVersion], references: [feedbackId, version], onDelete: Restrict)
  summary             String
  proposedRule        String?                      @map("proposed_rule")
  status              ProjectMemoryCandidateStatus @default(PENDING)
  proposedByAgentId   String                       @map("proposed_by_agent_id")
  reviewedByProfileId String?                      @map("reviewed_by_profile_id") @db.Uuid
  reviewedBy          Profile?                     @relation("ProjectMemoryCandidateReviewer", fields: [reviewedByProfileId], references: [id], onDelete: Restrict)
  reviewedAt          DateTime?                    @map("reviewed_at")
  invalidatedAt       DateTime?                    @map("invalidated_at")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  @@index([workspaceId, projectId, status], map: "project_memory_candidates_workspace_project_status_idx")
  @@index([feedbackId, feedbackVersion], map: "project_memory_candidates_feedback_version_idx")
  @@map("project_memory_candidates")
}

/// Cross-module append-only operating audit envelope from DBS-006. Persisted
/// writers are limited by reviewed migration/service catalogs: the no-secret
/// workspace creation event and TEAMCOLLAB-006 invitation lifecycle.
model OperatingAuditEvent {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt            DateTime @default(now()) @map("occurred_at")
  receivedAt            DateTime @default(now()) @map("received_at")
  actorType             String   @map("actor_type")
  actorRef              String?  @map("actor_ref")
  actorDisplay          String?  @map("actor_display")
  sessionRef            String?  @map("session_ref")
  requestRef            String?  @map("request_ref")
  ipAddressHash         String?  @map("ip_address_hash")
  userAgentHash         String?  @map("user_agent_hash")
  moduleKey             String   @map("module_key")
  action                String
  targetType            String   @map("target_type")
  targetRef             String?  @map("target_ref")
  targetDisplay         String?  @map("target_display")
  result                String
  riskLevel             String   @map("risk_level")
  approvalLevel         String   @map("approval_level")
  humanApprovalRequired Boolean  @map("human_approval_required")
  sourceKind            String   @map("source_kind")
  sourceRef             String?  @map("source_ref")
  agentRef              String?  @map("agent_ref")
  operationId           String?  @map("operation_id")
  proposalRef           String?  @map("proposal_ref")
