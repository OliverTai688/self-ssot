  threadId     String             @map("thread_id") @db.Uuid
  thread       ResearchThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  title        String
  sourceType   ResearchSourceType @default(PAPER) @map("source_type")
  authors      String[]           @default([])
  year         Int?
  doi          String?
  url          String?
  institution  String?
  region       String?
  country      String?
  language     String             @default("zh-TW")
  abstract     String?
  summary      String? // AI 自動產生的學術摘要
  originalText String?            @map("original_text")
  fileUrl      String?            @map("file_url")
  reliability  SourceReliability  @default(PRIMARY)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  feedbackRuns AIFeedbackRun[]

  @@map("research_sources")
}

model ResearchConcept {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId               String         @map("thread_id") @db.Uuid
  thread                 ResearchThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  name                   String
  aliases                String[]       @default([])
  definition             String?
  relatedSources         String[]       @default([]) @map("related_sources")
  relatedAuthors         String[]       @default([]) @map("related_authors")
  competingDefinitions   Json?          @default("[]") @map("competing_definitions")
  myCurrentUnderstanding String?        @map("my_current_understanding")
  aiClarification        String?        @map("ai_clarification")
  confusionPoints        String[]       @default([]) @map("confusion_points")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  @@map("research_concepts")
}

model ResearchWritingProject {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId         String               @map("thread_id") @db.Uuid
  thread           ResearchThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  title            String
  writingType      WritingProjectType   @default(PAPER) @map("writing_type")
  status           WritingProjectStatus @default(IDEA)
  targetVenueId    String?              @map("target_venue_id") @db.Uuid
  researchQuestion String?              @map("research_question")
  thesisStatement  String?              @map("thesis_statement")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  sections     ResearchWritingSection[]
  feedbackRuns AIFeedbackRun[]

  @@map("research_writing_projects")
}

model ResearchWritingSection {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String                 @map("project_id") @db.Uuid
  project         ResearchWritingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  sectionOrder    Int                    @map("section_order")
  body            String                 @default("")
  linkedSourceIds String[]               @default([]) @map("linked_source_ids")
  aiNotes         String[]               @default([]) @map("ai_notes")

  @@map("research_writing_sections")
}

model AIFeedbackRun {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId         String                 @map("thread_id") @db.Uuid
  thread           ResearchThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  writingProjectId String?                @map("writing_project_id") @db.Uuid
  writingProject   ResearchWritingProject? @relation(fields: [writingProjectId], references: [id], onDelete: SetNull)
  sourceId         String?                @map("source_id") @db.Uuid
  source           ResearchSource?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  inputType        String?                @map("input_type")
  perspective      ReviewPerspective      @default(FRIENDLY_MENTOR)
  summary          String
  strengths        String[]               @default([])
  weaknesses       String[]               @default([])
  questions        String[]               @default([])
  suggestions      String[]               @default([])
  actionItems      String[]               @default([]) @map("action_items")
  createdAt        DateTime               @default(now()) @map("created_at")

  @@map("ai_feedback_runs")
}

model ResearchDigest {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId           String         @map("thread_id") @db.Uuid
  thread             ResearchThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  scheduleType       String?        @map("schedule_type")
  title              String
  newSources         String[]       @default([]) @map("new_sources")
  keyFindings        String[]       @default([]) @map("key_findings")
  openQuestions      String[]       @default([]) @map("open_questions")
  recommendedReadings String[]       @default([]) @map("recommended_readings")
  writingSuggestions String[]       @default([]) @map("writing_suggestions")
  generatedAt        DateTime       @default(now()) @map("generated_at")

  @@map("research_digests")
}

model ResearchEvent {
  id                         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  eventType                  EventType         @default(CONFERENCE) @map("event_type")
  field                      String[]          @default([])
  location                   String?
  country                    String?
  isOnline                   Boolean           @default(false) @map("is_online")
  startDate                  DateTime?         @map("start_date")
  endDate                    DateTime?         @map("end_date")
  submissionDeadline         DateTime?         @map("submission_deadline")
  registrationDeadline       DateTime?         @map("registration_deadline")
  url                        String?
  cfpText                    String?           @map("cfp_text")
  relatedThreadIds           String[]          @default([]) @map("related_thread_ids")
  fitScore                   Int?              @map("fit_score")
  aiFitReason                String?           @map("ai_fit_reason")
  suggestedParticipationMode ParticipationMode @default(ATTEND) @map("suggested_participation_mode")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  @@map("research_events")
}

enum AgentMessageStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED

  @@map("agent_message_status")
}

model WorkflowRule {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  fromAgent        String         @map("from_agent")
  intent           String
  conditions       String?
  toAgent          String         @map("to_agent")
  targetIntent     String         @map("target_intent")
  mode             String         @default("broadcast")
  delaySeconds     Int            @default(0) @map("delay_seconds")
  requiresApproval Boolean        @default(false) @map("requires_approval")
  enabled          Boolean        @default(true)
  priority         Int            @default(100)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  messages AgentMessage[]

  @@map("workflow_rules")
}

model AgentMessage {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  traceId         String             @map("trace_id") @db.Uuid
  parentMessageId String?            @map("parent_message_id") @db.Uuid
  parent          AgentMessage?      @relation("MessageChain", fields: [parentMessageId], references: [id], onDelete: SetNull)
  children        AgentMessage[]     @relation("MessageChain")
  fromAgent       String             @map("from_agent")
  toAgent         String             @map("to_agent")
  intent          String
  payload         Json               @default("{}")
  status          AgentMessageStatus @default(PENDING)
  ruleId          String?            @map("rule_id") @db.Uuid
  rule            WorkflowRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  summary         String?
  errorMessage    String?            @map("error_message")
  createdAt       DateTime           @default(now()) @map("created_at")
  completedAt     DateTime?          @map("completed_at")

  @@map("agent_messages")
}

model AcademicPerson {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable pending TENANT-003 backfill migration; every future write must set this.
  // See ARC-033 and RES-020 — a global, ownerless row here would be visible to every tenant.
  ownerId               String?  @db.Uuid @map("owner_id")
  owner                 Profile? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String
  academicRole          String?  @map("academic_role")
  affiliation           String?
  country               String?
  profileUrl            String?  @map("profile_url")
  researchAreas         String[] @default([]) @map("research_areas")
  importantWorks        String[] @default([]) @map("important_works")
  relatedEvents         String[] @default([]) @map("related_events")
  backgroundSummary     String?  @map("background_summary")
  relevanceToMyResearch String?  @map("relevance_to_my_research")
  conversationAngles    String[] @default([]) @map("conversation_angles")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("academic_people")
}

enum AgentCommandType {
  SINGLE_AGENT
  TEAM_GROUP

  @@map("agent_command_type")
}

model AgentCommand {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId            String           @unique @map("operation_id")
  label                  String
  agentInstructionLabel  String           @map("agent_instruction_label")
  moduleKey              String           @map("module_key")
  ownerAgent             String           @map("owner_agent")
  targetModule           String           @map("target_module")
  riskLevel              String           @map("risk_level")
  approvalLevel          String           @map("approval_level")
  dataVisibilityLevel    String           @map("data_visibility_level")
  scopes                 String[]         @default([])
  allowedModes           String[]         @default(["dry_run"])
  uiEntrySurface         String           @map("ui_entry_surface")
  proposalOutputs        String[]         @default([]) @map("proposal_outputs")
  agentProposalOutputs   String[]         @default([]) @map("agent_proposal_outputs")
  blockedWrites          String[]         @default([]) @map("blocked_writes")
  agentBlockedWrites     String[]         @default([]) @map("agent_blocked_writes")
  sourceRefs             String[]         @default([]) @map("source_refs")
  promptTemplate         String?          @map("prompt_template")
  stages                 Json             @default("[]") @map("stages")
  commandType            AgentCommandType @default(SINGLE_AGENT) @map("command_type")
  participantAgents      String[]         @default([]) @map("participant_agents")
  writeBlocked           Boolean          @default(true) @map("write_blocked")
  externalRegisterable   Boolean          @default(false) @map("external_registerable")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  @@index([moduleKey, commandType])
  @@map("agent_commands")
}

model Skill {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String?     @map("workspace_id") @db.Uuid
  workspace          Workspace?  @relation("WorkspaceSkills", fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  instructions       String
  scope              SkillScope  @default(WORKSPACE)
  status             SkillStatus @default(ACTIVE)
  createdByProfileId String      @map("created_by_profile_id") @db.Uuid
  createdBy          Profile     @relation("SkillCreatedBy", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([workspaceId, status], map: "skills_workspace_status_idx")
  @@map("skills")
}

/// 使用者自己的營運工作台設定（基礎／個人）。一列一個 key，值以 Json 保存，
/// 可用的 key 與型別由 src/lib/settings/operating-settings.catalog.ts 定義。
model UserSetting {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String       @map("profile_id") @db.Uuid
  profile   Profile      @relation("UserSettingProfile", fields: [profileId], references: [id], onDelete: Cascade)
  scope     SettingScope
  key       String
  value     Json
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([profileId, scope, key])
  @@index([profileId, scope], map: "user_settings_profile_scope_idx")
  @@map("user_settings")
}

/// 組織級設定：只有具負責人席位的帳號可以寫，所有成員都讀得到（這些值會影響他們看到什麼）。
/// orgKey 目前固定為單一組織，保留欄位是為了之後真的多租戶時不用再改主鍵。
model OrganizationSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgKey      String   @map("org_key")
  key         String
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedBy   Profile? @relation("OrganizationSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([orgKey, key])
  @@index([orgKey], map: "organization_settings_org_key_idx")
  @@map("organization_settings")
}

// ─── 營運三軌與 time_spine（ARC-041 · PLN-073 T5）─────────────────────────────
// 專案軌沿用既有的 Project → ProjectPhaseNode → ProjectMilestone，往下補 Objective；
// 節奏軌與行政／活動軌是新的。time_spine 是衍生索引，由服務層單一 writer 維護。

enum RhythmKind {
  // 會議或習慣：standup / 1:1 / 回顧 / 學習日 —— 計入履行率
  RITUAL
  // 週期性行政義務：發薪 / 勞健保 / 報稅 —— 進日曆與提醒，但不計履行率
  ADMIN

  @@map("rhythm_kind")
}

enum RhythmScope {
  COMPANY
  PERSONAL

  @@map("rhythm_scope")
}

enum RhythmSessionState {
  DONE
  SKIP
  MOVED

  @@map("rhythm_session_state")
}

enum OccasionCategory {
  COMPANY_EVENT
  CLIENT_MEETING
  TRAVEL
  BIRTHDAY
  VISIT
  ADMIN

  @@map("occasion_category")
}

enum OperatingMediaKind {
  AUDIO
  PHOTO
  DOC

  @@map("operating_media_kind")
}

enum SpineTrack {
  PROJECT
  RHYTHM
  OCCASION

  @@map("spine_track")
}

enum SpineState {
  PLANNED
  DONE
  LATE
  MISSED
  SKIPPED

  @@map("spine_state")
}

/// 里程碑底下的「怎樣才算做到」。達成率由底下的 ProjectTask 推算。
model ProjectObjective {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  milestoneId String           @map("milestone_id") @db.Uuid
  milestone   ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title       String
  workbenchRef String? @map("workbench_ref")

  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tasks ProjectTask[]

  @@index([milestoneId], map: "project_objectives_milestone_idx")
  @@map("project_objectives")
}

/// 日常節奏的規則本體。未來實例不預存，查詢期由 RRULE 展開（ARC-041 §2.1）。
model Rhythm {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  workspace   Workspace   @relation("WorkspaceRhythms", fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  workbenchRef String? @map("workbench_ref")

  kind        RhythmKind  @default(RITUAL)
  scope       RhythmScope @default(COMPANY)
  ownerIds    String[]    @map("owner_ids") @db.Uuid
  /// RFC 5545，例 FREQ=WEEKLY;INTERVAL=2;BYDAY=TU
  rrule       String
  /// 天粒度、當地日語意；夏令時間下「每週五 13:00」仍是當地的 13:00
  dtstart     DateTime    @map("dtstart") @db.Date
  until       DateTime?   @db.Date
  timeOfDay   String?     @map("time_of_day")
  timezone    String      @default("Asia/Taipei")
  expectMedia String[]    @map("expect_media")
  /// 由契約條文或法規推導 —— 帶值者不可編輯或刪除
  derivedFrom String?     @map("derived_from")
  remind      String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  sessions RhythmSession[]

  @@index([workspaceId, kind, active], map: "rhythms_workspace_kind_idx")
  @@map("rhythms")
}

/// 節奏的單次實例。只有「發生了事情」才落一筆 —— 等同 iCalendar 的 RECURRENCE-ID 覆寫。
model RhythmSession {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rhythmId       String             @map("rhythm_id") @db.Uuid
  rhythm         Rhythm             @relation(fields: [rhythmId], references: [id], onDelete: Cascade)
  /// 規則算出的原始日期，也是覆寫鍵
  occurrenceDate DateTime           @map("occurrence_date") @db.Date
  state          RhythmSessionState
  movedTo        DateTime?          @map("moved_to") @db.Date
  note           String?
  spawnedTaskIds String[]           @map("spawned_task_ids") @db.Uuid
  recordedById   String?            @map("recorded_by_id") @db.Uuid
  recordedAt     DateTime           @default(now()) @map("recorded_at")

  mediaItems OperatingMedia[]

  @@unique([rhythmId, occurrenceDate], map: "rhythm_sessions_occurrence_key")
  @@index([rhythmId, occurrenceDate], map: "rhythm_sessions_rhythm_date_idx")
  @@map("rhythm_sessions")
}

/// 行政／活動：一次性時間點或短區間，重點在事前準備與事後留下的素材。
model Occasion {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  workspace      Workspace        @relation("WorkspaceOccasions", fields: [workspaceId], references: [id], onDelete: Cascade)
  title          String
  /// 工作台的業務 id（PRJ-2026-004 之類）。主鍵是由它推導的 UUIDv5，而那是單向的——
  /// 沒有這一欄就讀不回工作台需要的 id，關聯（issue.p、milestone.projectId）也接不回去。
  workbenchRef String? @map("workbench_ref")

  category       OccasionCategory @default(COMPANY_EVENT)
  onDate         DateTime         @map("on_date") @db.Date
  endOn          DateTime?        @map("end_on") @db.Date
  startsAt       DateTime?        @map("starts_at")
  endsAt         DateTime?        @map("ends_at")
  place          String?
  actorIds       String[]         @map("actor_ids") @db.Uuid
  externalGuests String?          @map("external_guests")
  star           Boolean          @default(false)
  projectId      String?          @map("project_id") @db.Uuid
  project        Project?         @relation("ProjectOccasions", fields: [projectId], references: [id], onDelete: SetNull)
  /// [{ t, done, dueOn?, taskId? }]
  prep           Json             @default("[]")
  recap          String?
  // ── 會議（PLN-075 OD-D：擴充 Occasion，不另開 ProjectMeeting）─────────────
  /// 會議資料夾。語意是「資料夾 ←→ 會議 1:1 連結」，所以是 @unique 而不是普通索引。
  folderId       String?          @unique @map("folder_id") @db.Uuid
  folder         ProjectFolder?   @relation("OccasionFolder", fields: [folderId], references: [id], onDelete: SetNull)
  /// 會議「注意事項」。`recap` 已經是**結論**，兩者是不同的東西：
  /// 結論是這場會議產出了什麼，注意事項是下一次要先知道的前提。
  cautions       String?
  derivedFrom    String?          @map("derived_from")
  remind         String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  mediaItems OperatingMedia[]

  @@index([workspaceId, onDate], map: "occasions_workspace_date_idx")
  @@index([projectId], map: "occasions_project_idx")
  @@map("occasions")
}

/// 節奏紀錄與活動的素材。檔案本體沿用 SCH-005 的 R2 儲存。
model OperatingMedia {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       OperatingMediaKind
  url        String
  filename   String
  bytes      Int                @default(0)
  transcript String?
  sessionId  String?            @map("session_id") @db.Uuid
  session    RhythmSession?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  occasionId String?            @map("occasion_id") @db.Uuid
  occasion   Occasion?          @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([sessionId], map: "operating_media_session_idx")
  @@index([occasionId], map: "operating_media_occasion_idx")
  @@map("operating_media")
}

/// 三軌匯流的扁平索引。只索引「已具體化」的東西；節奏的未來實例由查詢期展開後合併。
/// 衍生資料，由 src/lib/services/operating-spine.service.ts 單一 writer 維護，
/// 並由 scripts/reconcile-time-spine.ts 定期對帳（ARC-041 §3）。
// ─── 營運工作台的日常協作資料（SCH-008 · PLN-074 M2）────────────────────────
// Project 由 Work 模組擁有；營運專屬欄位放 1:1 側表（SCH-008 §3 決定 C）。

/// 圓展營運專案的專屬欄位。主鍵即 projectId：1:1 共用主鍵，沒有第二個 id 要對齊。
model OperatingProjectProfile {
  projectId       String         @id @map("project_id") @db.Uuid
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client          String?
  workbenchRef String? @map("workbench_ref")

  goalId          String?        @map("goal_id") @db.Uuid
  goal            OperatingGoal? @relation("OperatingGoalProjects", fields: [goalId], references: [id], onDelete: SetNull)
  /// 產品交付型 / 行銷服務型 / 未確認
  engagementType  String?        @map("engagement_type")
  /// 工作台的原始狀態（商機 / 進行中 / 驗收中）；ProjectStatus 是給 Work 模組的粗分類
  operatingStatus String         @default("商機") @map("operating_status")
  /// 對外四狀態。operatingStatus 留作子階段，獎金閘門③仍讀它。
  dealStage       ProjectDealStage @default(CHALLENGEABLE) @map("deal_stage")
  /// 進入目前這一格的日期。沒有它就答不出「何時走到這一期」——
  /// 舊的做法是直接覆寫狀態字串，歷史不留。
  stageEnteredAt  DateTime?      @map("stage_entered_at") @db.Date
  /// 獎金率與上限是專案設定，不是帳務憑證；M4 之前不據以產生任何應付金額
  bonusRatePct    Int            @default(0) @map("bonus_rate_pct")
  bonusCapPct     Int            @default(0) @map("bonus_cap_pct")
  budgetAmount    Int            @default(0) @map("budget_amount")
  evidenceRepoTag String?        @map("evidence_repo_tag")
  startedOn       DateTime?      @map("started_on") @db.Date
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([goalId], map: "operating_project_profiles_goal_idx")
  @@map("operating_project_profiles")
}

/// 年度／季目標。公司層級（SCH-008 §8）。
model OperatingGoal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  title       String
  period      String
  workbenchRef String? @map("workbench_ref")

  progressPct Int      @default(0) @map("progress_pct")
  warning     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projects OperatingProjectProfile[] @relation("OperatingGoalProjects")

  @@index([workspaceId], map: "operating_goals_workspace_idx")
  @@map("operating_goals")
}

/// 書寫式日誌。一人一天一筆。
model OperatingJournalEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Profile.id，與 rhythm_sessions.recorded_by_id 一樣不設外鍵：停用成員時保留歷史作者
  authorId    String   @map("author_id") @db.Uuid
  onDate      DateTime @map("on_date") @db.Date
  title       String?
  /// typed block 陣列。block 種類仍在演進，早期正規化會讓每次 UI 調整都變成 migration。
  blocks      Json     @default("[]")
  /// company | private —— private 只有作者讀得到，即使同 workspace（契約 §18）
  visibility  String   @default("company")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, authorId, onDate], map: "operating_journal_author_day_key")
  @@index([workspaceId, onDate], map: "operating_journal_workspace_date_idx")
  @@map("operating_journal_entries")
}

/// 日誌行內留言、物件留言、一般留言合一。
model OperatingComment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// Profile.id；對不到人時留空，作者身分仍由 authorKey 保住
  authorId    String?   @map("author_id") @db.Uuid
  /// 席位字串（yz / lily）。工作台顯示的是這個，不是 uuid
  authorKey   String?   @map("author_key")
  workbenchRef String?  @map("workbench_ref")
  /// journal | line | object
  targetType  String    @map("target_type")
  targetRef   String    @map("target_ref")
  parentId    String?   @map("parent_id") @db.Uuid
  body        String
  /// 工作台顯示用的時間字串（'10:20'）與 line 留言的 blockId／day
  meta        Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 軟刪除：留言被引用過就不能真的消失，否則被引用的那一頭會指向空白
  deletedAt   DateTime? @map("deleted_at")

  @@index([workspaceId, targetType, targetRef], map: "operating_comments_target_idx")
  @@index([parentId], map: "operating_comments_parent_idx")
  @@map("operating_comments")
}

/// 決議紀錄。
/// 日誌裡的請求與回覆流。options／replies／nudges 形狀仍在演進，先整包存。
model OperatingRequest {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  workbenchRef String?  @map("workbench_ref")
  fromKey      String?  @map("from_key")
  toKey        String?  @map("to_key")
  onDate       DateTime? @map("on_date") @db.Date
  blockId      String?  @map("block_id")
  text         String
  kind         String   @default("ask")
  sentAt       DateTime? @map("sent_at")
  payload      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, onDate], map: "operating_requests_workspace_date_idx")
  @@map("operating_requests")
}

model OperatingDecision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  authorId    String?  @map("author_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  title       String
  workbenchRef String? @map("workbench_ref")

  body        String?
  decidedOn   DateTime? @map("decided_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, decidedOn], map: "operating_decisions_workspace_date_idx")
  @@map("operating_decisions")
}

// ─── Evidence、承諾、容量（SCH-008 · PLN-074 M3）─────────────────────────────

/// 契約條文。條文陣列用 Json：它們是文件的一部分，不會被單獨查詢或改寫。
model OperatingDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// 內部 / 外部
  direction   String
  title       String
  workbenchRef String? @map("workbench_ref")

  /// [{ id, ref, text }]
  clauses     Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId], map: "operating_documents_workspace_idx")
  @@map("operating_documents")
}

/// 由條文推導的承諾。履行紀錄存 Json —— 比對發生在承諾這一層，
/// 拆成子表會讓單次 commit 產生兩種列變更，而 diff 只認得一種。
model OperatingCommitment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  documentRef String?  @map("document_ref")
  clauseRef   String?  @map("clause_ref")
  direction   String
  title       String
  workbenchRef String? @map("workbench_ref")

  ownerKey    String?  @map("owner_key")
  status      String
  cadence     String?
  /// [{ d, t, src, ok }] 履行 log。空白不代表沒做，代表沒有紀錄。
  logs        Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status], map: "operating_commitments_workspace_status_idx")
  @@map("operating_commitments")
}

/// 專案聊天室。
model OperatingThread {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  title       String
  workbenchRef String? @map("workbench_ref")

  closed      Boolean  @default(false)
  /// [{ w, ts, x }]
  messages    Json     @default("[]")
  closeNote   Json?    @map("close_note")
  files       String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, projectId], map: "operating_threads_workspace_project_idx")
  @@map("operating_threads")
}

/// Evidence Repo：一個專案一份。檔案本體仍在 R2（SCH-005），這裡存目錄與版本。
model OperatingEvidenceRepo {
  projectId   String   @id @map("project_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  version     String   @default("v0.1")
  workbenchRef String? @map("workbench_ref")

  frozen      Boolean  @default(false)
  readme      String?
  /// [{ v, t, st }]
  versions    Json     @default("[]")
  /// [{ f, dir, note, ok }]
  tree        Json     @default("[]")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId], map: "operating_evidence_repos_workspace_idx")
  @@map("operating_evidence_repos")
}

/// 容量配置與出勤，一人一列。
/// 以席位字串（yz / lily）而不是 Profile uuid 當鍵：席位是工作台的身分概念，
/// 而且 Profile 還沒建立時也要能存 —— 對不到人就整筆存不了會是更糟的失敗。
model OperatingCapacityPlan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorKey    String   @map("actor_key")
  /// [[label, pct, target]]
  allocations Json     @default("[]")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, actorKey], map: "operating_capacity_actor_key")
  @@map("operating_capacity_plans")
}

model OperatingTimesheet {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorKey    String   @map("actor_key")
  /// [{ wk, from, days, est, st, conf }] 分鐘粒度；由本人確認，不由系統推估
  weeks       Json     @default("[]")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, actorKey], map: "operating_timesheet_actor_key")
  @@map("operating_timesheets")
}

// ─── 帳務（SCH-008 §5 · PLN-074 M4）──────────────────────────────────────────
// 這些表存的是使用者自己輸入的數字。database 模式不載入任何 fixture，所以原型裡
// 那些合成的費率與金額不會進到這裡 —— 這正是 SCH-008 §5 當初要避免的事。
// 規則（獎金公式、稅務、薪資級距）仍不在系統裡，工作台是在前端試算。

model OperatingTransaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  onDate      DateTime @map("on_date") @db.Date
  title       String
  workbenchRef String? @map("workbench_ref")

  projectRef  String?  @map("project_ref")
  category    String?
  /// 未稅金額，支出為負。整數避免浮點誤差累積在對帳上。
  amount      Int      @default(0)
  /// 使用者輸入的算式（=SUM(D1:D3) 之類），保留原文才能重新檢查怎麼算出來的
  formula     String?
  /// 代收代付：不計入可分配毛利
  passThrough Boolean  @default(false) @map("pass_through")
  /// 應收／應付的到期日。onDate 是經濟事件何時成立，dueDate 是錢何時該進出。
  dueDate     DateTime? @map("due_date") @db.Date
  /// 真的收付那一天。與 dueDate 的差就是這個對象的付款落差。
  settledDate DateTime? @map("settled_date") @db.Date
  /// estimated / committed / actual —— RES-032 §2.3 缺的第五個維度「確定性」。
  certainty   String   @default("actual")
  /// 勾稽到哪一期合約期款（工作台業務 id）
  contractTermRef String? @map("contract_term_ref")
  /// 憑證種類清單（發票／合約／匯款單）
  vouchers    String[]
  /// 憑證檔案（RES-032）：[{ objectKey, name, type, bytes, at, by }]。bytes 在 R2，這裡只留 key。
  /// 另開一欄而不是把 vouchers 改型別：既有列不需要搬資料，種類標籤與檔案可以各自存在。
  attachments Json     @default("[]")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, onDate], map: "operating_transactions_workspace_date_idx")
  @@map("operating_transactions")
}

model OperatingReimbursement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorKey    String?  @map("actor_key")
  title       String
  workbenchRef String? @map("workbench_ref")

  amount      Int      @default(0)
  /// 待送 / 已核 / 已付
  status      String   @default("待送")
  onDate      DateTime? @map("on_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status], map: "operating_reimbursements_workspace_status_idx")
  @@map("operating_reimbursements")
}

/// 銀行明細。matchedRef 指向交易，是對帳的結果而不是外鍵：
/// 對不上的那幾筆正是對帳要看的東西，不能因為外鍵約束而存不進來。
model OperatingBankEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  onDate      DateTime @map("on_date") @db.Date
  title       String
  workbenchRef String? @map("workbench_ref")

  amount      Int      @default(0)
  matchedRef  String?  @map("matched_ref")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId, onDate], map: "operating_bank_entries_workspace_date_idx")
  @@map("operating_bank_entries")
}

/// 收件匣的一筆單據（RES-032 §5.2 生命週期 ①②）。
///
/// 收單面只能把東西推到「待歸帳」，不能直接產生交易：同事不需要懂類別。
/// 記帳者歸帳時才建立 OperatingTransaction，並把 postedRef 指回去。
/// 代墊的單據會同時有一筆報帳（reimbRef），核准後才出現在待歸帳。
model OperatingIntakeItem {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  workbenchRef String?   @map("workbench_ref")
  actorKey     String?   @map("actor_key")
  title        String
  /// 缺金額就是 null：收件匣要顯示「缺金額」，不能用 0 假裝有值
  amount       Int?
  onDate       DateTime? @map("on_date") @db.Date
  projectRef   String?   @map("project_ref")
  /// draft（缺資料）/ unfiled（待歸帳）/ posted（已入帳）/ discarded
  status       String    @default("draft")
  /// { objectKey, name, type, bytes }；bytes 走 R2
  file         Json?
  reimbRef     String?   @map("reimb_ref")
  postedRef    String?   @map("posted_ref")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, status], map: "operating_intake_items_workspace_status_idx")
  @@index([workspaceId, workbenchRef], map: "operating_intake_items_ref_idx")
  @@map("operating_intake_items")
}

/// 月結（RES-032 §5.4 B-3）。一個月份一列；status=closed 時該月交易的金額、日期、歸屬唯讀。
/// 可加註、可補憑證（Owner 決策 2026-09-25：可加註不可改金額）。解鎖要填原因並留在 log。
model OperatingPeriod {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// YYYY-MM
  period      String
  status      String    @default("open")
  closedBy    String?   @map("closed_by")
  closedAt    DateTime? @map("closed_at")
  /// 鎖定當下的檢查結果快照
  checklist   Json      @default("[]")
  /// [{ at, by, action: 'close'|'reopen', reason }]
  log         Json      @default("[]")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, period], map: "operating_periods_workspace_period_key")
  @@map("operating_periods")
}

/// 專案的對外四狀態（需求一）。
///
/// 對內的 `OperatingProjectProfile.operatingStatus`（商機／進行中／驗收中）維持不動：
/// 獎金結算閘門③「內部驗收（14 日）」讀的是它。把兩者收斂成一個欄位會讓那一項失效，
/// 所以這裡是「對外四格 + 對內子階段」而不是取代。
enum ProjectDealStage {
  CHALLENGEABLE
  PROPOSED
  WON
  CLOSED

  @@map("project_deal_stage")
}

/// 合約。期款的家。
///
/// 金流原本六張帳務表全部只記錄「已發生」的錢；合約與期款是另一半 ——
/// 承諾了、但還沒發生。沒有這兩張表，Runway 與應收未收就只能是寫死的字面值。
model OperatingContract {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  workbenchRef String?  @map("workbench_ref")
  projectId    String   @map("project_id") @db.Uuid
  project      Project  @relation("ProjectContracts", fields: [projectId], references: [id], onDelete: Cascade)
  title        String?
  /// 未稅總額。期款金額的總和不強制等於它：部分收款、折讓與追加都會讓兩者分家。
  totalAmount  Int      @default(0) @map("total_amount")
  currency     String   @default("TWD")
  /// 月結天數（30／60）。建立期款時用來推預計收款日。
  paymentTermsDays Int  @default(30) @map("payment_terms_days")
  clauseRef    String?  @map("clause_ref")
  signedOn     DateTime? @map("signed_on") @db.Date
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  terms        OperatingContractTerm[]
  /// 一份合約通常就是一「期」（PLN-075 資源③）。
  phaseCycles  ProjectPhaseCycle[]     @relation("ContractPhaseCycles")

  @@index([workspaceId, projectId], map: "operating_contracts_workspace_project_idx")
  @@index([workspaceId, workbenchRef], map: "operating_contracts_ref_idx")
  @@map("operating_contracts")
}

/// 合約期款。需求一的核心。
///
/// `amount` 是權威，`pctOfTotal` 只是建立當下的輔助值、不回算 ——
/// 改合約總額若回頭改已存在的期款金額，部分收款、折讓與匯差就全部對不上。
///
/// 兩個日期是刻意分開的：`expectedOn` 是合約寫的到期日，`settledOn` 是真的到帳那天。
/// 兩者的差是「這個客戶的付款落差」，推演用它平移未來期款 —— 到期日不足以預測現金。
model OperatingContractTerm {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  workbenchRef String?  @map("workbench_ref")
  contractId   String   @map("contract_id") @db.Uuid
  contract     OperatingContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  seq          Int
  label        String
  amount       Int      @default(0)
  /// 可為空＝建立時沒用比例算。存了也不參與任何計算。
  pctOfTotal   Int?     @map("pct_of_total")
  /// milestone / date / manual
  triggerKind  String   @default("date") @map("trigger_kind")
  milestoneRef String?  @map("milestone_ref")
  expectedOn   DateTime @map("expected_on") @db.Date
  invoicedOn   DateTime? @map("invoiced_on") @db.Date
  settledOn    DateTime? @map("settled_on") @db.Date
  /// pending / invoiced / settled / written_off
  status       String   @default("pending")
  /// 勾稽到帳本哪一筆收入（工作台的業務 id，不做外鍵：對不上的那幾筆正是要看的東西）
  txnRef       String?  @map("txn_ref")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, expectedOn], map: "operating_contract_terms_workspace_expected_idx")
  @@index([contractId, seq], map: "operating_contract_terms_contract_seq_idx")
  @@index([workspaceId, workbenchRef], map: "operating_contract_terms_ref_idx")
  @@map("operating_contract_terms")
}

/// 現金帳戶。帳戶燈的分子來源。
///
/// 只記期初餘額與基準日；之後的水位由「已勾稽」的交易推導，不另存一個會漂移的餘額欄。
model OperatingCashAccount {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  workbenchRef String?  @map("workbench_ref")
  name         String
  kind         String   @default("bank")
  openingBalance Int    @default(0) @map("opening_balance")
  openingAsOf  DateTime @map("opening_as_of") @db.Date
  currency     String   @default("TWD")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([workspaceId], map: "operating_cash_accounts_workspace_idx")
  @@map("operating_cash_accounts")
}

/// 支出假設與燈號門檻。一個工作區一列。
///
/// 每月支出是使用者自己填的數字，不從歷史平均推：兩人公司的月份差異比趨勢大，
/// 用平均會在剛好需要準確的那個月失準。機率與門檻也放這裡，不寫死在程式碼。
model OperatingCashAssumption {
  workspaceId     String   @id @map("workspace_id") @db.Uuid
  monthlyBurn     Int      @default(0) @map("monthly_burn")
  runwayGreenMonths Int    @default(6) @map("runway_green_months")
  runwayAmberMonths Int    @default(3) @map("runway_amber_months")
  /// 覆蓋率門檻存成百分比整數，避免浮點數進資料庫（120 = 1.2 倍）
  coverageGreenPct Int     @default(120) @map("coverage_green_pct")
  coverageAmberPct Int     @default(80) @map("coverage_amber_pct")
  overdueAmberDays Int     @default(14) @map("overdue_amber_days")
  overdueRedDays   Int     @default(30) @map("overdue_red_days")
  /// 四狀態的加權機率（百分比整數）。已接案與已結案不打折，所以不存。
  probChallengeablePct Int @default(20) @map("prob_challengeable_pct")
  probProposedPct  Int     @default(50) @map("prob_proposed_pct")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("operating_cash_assumptions")
}

/// 薪資試算草稿。runtime 自己就說「只更新本頁示例試算，不付款」——
/// 這張表保存的是那份試算，不是薪資發放紀錄，也不產生任何應付義務。
model OperatingPayrollDraft {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorKey    String   @map("actor_key")
  baseAmount  Int      @default(0) @map("base_amount")
  overtime    Int      @default(0)
  milestone   Int      @default(0)
  separate    Boolean  @default(false)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, actorKey], map: "operating_payroll_actor_key")
  @@map("operating_payroll_drafts")
}

// ─── 文件庫與文件物件（PLN-074 M6）──────────────────────────────────────────

/// 文件庫檔案。版本陣列存 Json，bytes 不在這裡 —— 走 R2，只留 objectKey。
model OperatingLibraryFile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  workbenchRef String?  @map("workbench_ref")
  name         String
  category     String   @default("material")
  tags         String   @default("")
  /// team = 公司文件庫；personal = 私人文件，只有作者讀得到
  space        String   @default("team")
  authorKey    String?  @map("author_key")
  /// [{ id, name, type, text, objectKey, bytes, at }]
  /// 文字檔內容留在 text（小、且讓搜尋可用）；二進位檔只留 objectKey。
  versions     Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, space], map: "operating_library_files_workspace_space_idx")
  @@index([workspaceId, workbenchRef], map: "operating_library_files_ref_idx")
  @@map("operating_library_files")
}

/// 日誌／文件庫／金流共用的一份檔案資產：bytes 在 Cloudflare R2，這裡只存座標與身分。
///
/// 為什麼不是把 objectKey 塞進 OperatingLibraryFile.versions[] 就好：那樣檔案永遠只是
/// 某張表的一個欄位，沒有自己的 id，所以進不了 mentionHits()、@ 不到、物件索引也掃不到。
/// 這張表讓一份檔案有唯一的家 —— 與「物件有唯一的家」同一條原則。
///
/// signed URL 一律即時產生、永不落地（AUT-004）；這裡只存 bucket 與 objectKey。
model OperatingAsset {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  workbenchRef String?   @map("workbench_ref")
  /// AST-JRNL-000124-20260928（RES-018）。由伺服器指派一次，永不重生成。
  /// 前端計數器撞號曾讓寫入佇列卡死並撞出渲染無限遞迴（YZUI-020），所以不放前端。
  refCode      String    @unique @map("ref_code")
  /// image | pdf | doc | sheet | slide | audio | video —— 決定卡片主體與索引 facet
  kind         String
  /// 顯示名稱可以改；改了不影響 refCode，引用因此不會失效
  displayName  String    @map("display_name")
  bucket       String
  /// operating/{workspaceId}/asset/{yyyy-mm}/{uuid}{ext}；由伺服器決定，不採用前端送來的路徑
  objectKey    String    @map("object_key")
  mimeType     String?   @map("mime_type")
  sizeBytes    Int?      @map("size_bytes")
  /// finalize 時由 HeadObject 的 ETag 寫入，不信任前端回報
  contentHash  String?   @map("content_hash")
  /// uploading | ready | failed。只有 ready 進得了 @ 選單與物件索引
  status       String    @default("uploading")
  /// multipart 進行中才有；complete 或 abort 之後清空
  uploadId     String?   @map("upload_id")
  /// team = 全員可見；personal = 只有作者讀得到（下載授權依這欄）
  space        String    @default("team")
  authorKey    String?   @map("author_key")
  /// journal | library | cashflow —— 從哪道門進來的
  origin       String    @default("journal")
  /// 誕生在哪一天的日誌。日誌那一行刪掉之後，物件索引還靠它標出來源
  bornDay      DateTime? @map("born_day") @db.Date
  bornAt       DateTime? @map("born_at")
  /// 抽出來的純文字，讓物件索引搜得到內容（P3 才會有值）
  extractedText String?  @map("extracted_text")
  durationSec  Int?      @map("duration_sec")
  transcript   String?
  // ── 專案雲端硬碟（PLN-075 OD-E：OperatingAsset 是專案檔案唯一的家）─────────
  /// 專案範圍的檔案才有值。授權因此走得到 assertCanAccessProject，不只看 workspaceId。
  /// 刻意不加外鍵：這張表自己的慣例就是不加（`workspace_id` 同），而且專案被刪除時
  /// cascade 與 restrict 都不對 —— bytes 在 R2，該由孤兒清理處理，不是由 FK。
  projectId    String?   @map("project_id") @db.Uuid
  /// 在硬碟樹上的位置。null＝還沒接上專案硬碟的既有檔案（日誌／文件庫／金流三道門）。
  /// 搬移只改這一欄，`objectKey` 永不變動 —— 這是把資料夾放在 DB 而不是 key 裡的回報。
  folderId     String?   @map("folder_id") @db.Uuid
  /// 被整理出收件匣的時刻。null＝待整理。
  /// 另外存而不是只看 folderId：使用者把檔案又移回收件匣之後，
  /// 「整理過沒有」這個問題仍然答得出來。
  filedAt      DateTime? @map("filed_at")
  /// { "thumb480": "operating/{ws}/derived/{assetId}/thumb-480.webp", "poster": "…" }
  /// 衍生檔座標。形狀仍在演進（縮圖尺寸、影片 poster、PDF 首頁），先整包存。
  derivatives  Json      @default("{}")

  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([bucket, objectKey], map: "operating_assets_object_key_unique")
  @@index([workspaceId, status], map: "operating_assets_workspace_status_idx")
  @@index([workspaceId, bornDay], map: "operating_assets_workspace_day_idx")
  @@index([workspaceId, workbenchRef], map: "operating_assets_ref_idx")
  @@index([projectId, folderId, status], map: "operating_assets_project_folder_idx")
  @@index([projectId, filedAt], map: "operating_assets_project_filed_idx")
  @@map("operating_assets")
}

/// 日誌裡召喚出來的結構化文件物件（會議紀錄、訪談稿之類）。
model OperatingDocObject {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  workbenchRef String?  @map("workbench_ref")
  kind         String
  subKind      String?  @map("sub_kind")
  title        String
  /// 系統自動命名；使用者改過標題後關閉
  titleAuto    Boolean  @default(true) @map("title_auto")
  onDate       DateTime? @map("on_date") @db.Date
  authorKey    String?  @map("author_key")
  /// { collapsed, secs: [{ title, blocks }] } —— 區段形狀仍在演進
  payload      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, onDate], map: "operating_doc_objects_workspace_date_idx")
  @@index([workspaceId, workbenchRef], map: "operating_doc_objects_ref_idx")
  @@map("operating_doc_objects")
}

/// 日誌右欄「今日脈絡」的一列事件（PLN-074 M7）。
///
/// 一筆事件一列，不是「一天一列」：一天一列的話，兩個席位同一天各做一件事就會
/// 互相覆蓋整天的脈絡，最後只留下後寫的那個人。逐列之後，兩個人的動作自然合流成
/// 同一條時間軸，跨裝置合併也只需要比對列，不必處理陣列的合併。
///
/// kind：start＝開始一天、close＝收工、act＝其他動作（召喚物件、留言、發出請求…）。
/// 「開始一天」「收工」不另外開表：它們本來就是這條時間軸上的兩個事件，
/// 拆出去只會讓同一件事有兩個真相。
model OperatingDayLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  workbenchRef String?  @map("workbench_ref")
  onDate       DateTime @map("on_date") @db.Date
  /// Profile.id；對不到人時留空，身分仍由 actorKey 保住
  actorId      String?  @map("actor_id") @db.Uuid
  /// 席位字串（yz / lily）。工作台顯示與著色看的是這個
  actorKey     String?  @map("actor_key")
  /// 工作台顯示用的時間字串（'10:20'）。這是**掛在 onDate 那天**的時間，
  /// 回頭補記時它是補記當下的時鐘，在 onDate 的時間軸上並不成立 —— 看 occurredAt 才知道真的是何時寫的
  atTime       String   @map("at_time")
  /// 真正發生（寫下）的時刻。與 onDate 不同天，就是補記。
  /// 可空：這張表先上線、這個欄位後補，舊列由 createdAt 頂上
  occurredAt   DateTime? @map("occurred_at")
  /// start | close | act
  kind         String   @default("act")
  text         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([workspaceId, onDate], map: "operating_day_logs_workspace_date_idx")
  @@index([workspaceId, workbenchRef], map: "operating_day_logs_ref_idx")
  @@map("operating_day_logs")
}

/// 日誌裡標記的「今日議題」（PLN-074 M7）。
///
/// 議題的 id 被寫回日誌 block 的 `today` 欄位，而 block 本來就存得住。
/// 少了這張表，重新整理之後 block 還指著一個已經不存在的議題，
/// 已完成的標籤就跟著消失 —— 看起來像標記沒被記住，其實是被指到的那一頭不見了。
model OperatingTodayIssue {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  workbenchRef String?   @map("workbench_ref")
  /// Profile.id；對不到人時留空，身分仍由 authorKey 保住
  authorId     String?   @map("author_id") @db.Uuid
  authorKey    String?   @map("author_key")
  /// 議題目前掛在哪一天（延後會往後移）
  onDate       DateTime  @map("on_date") @db.Date
  /// 日誌裡那一行的 block id
  blockId      String?   @map("block_id")
  text         String
  /// 標記的時刻與完成的時刻。存 timestamp 而不是 epoch 數字：
  /// 工作台要的是毫秒，但把毫秒存成 BIGINT 之後，JSON 序列化會在 BigInt 上炸掉，
  /// 而且查帳時看到的是一串數字。轉換留在邊界上做，欄位本身保持可讀。
  flaggedAt    DateTime? @map("flagged_at")
  doneAt       DateTime? @map("done_at")
  /// 延後過幾次；>0 時隔天日誌開頭會出現「從昨天帶來」
  deferred     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, onDate], map: "operating_today_issues_workspace_date_idx")
  @@index([workspaceId, workbenchRef], map: "operating_today_issues_ref_idx")
  @@map("operating_today_issues")
}

/// 營運工作台的命令紀錄（PLN-074 M7）。
///
/// 為什麼不寫 operating_audit_events：那張表是 teamcollab 的高風險稽核目錄，
/// CHECK constraint 只允許 workspace.created 這類具名動作，且強制 module_key='work'、
/// risk_level='HIGH'、human_approval_required=true。工作台的一般命令塞不進去，
/// 而把它們硬塞或乾脆不記錄都是錯的答案 —— 前者污染高風險目錄，後者讓每一次寫入都無跡可循。
///
/// 這張表同時是冪等的依據：client_ref_hash 唯一，重送同一個 clientRef 不會二次套用。
model OperatingCommandLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  /// clientRef 的 SHA256。存雜湊而不是原值：它由客戶端生成，不該原樣落進資料庫。
  clientRefHash  String   @map("client_ref_hash")
  actorProfileId String?  @map("actor_profile_id") @db.Uuid
  actorKey       String?  @map("actor_key")
  op             String
  /// 稽核顯示用的中文物種名與這一筆的名字
  entity         String
  label          String
  /// 這次命令碰到的集合，查帳時用來定位
  collections    String[]
  changeCount    Int      @default(0) @map("change_count")
  /// low | high —— 帳務集合的變更要與一般編輯分得開
  riskLevel      String   @default("low") @map("risk_level")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, clientRefHash], map: "operating_command_log_client_ref_key")
  @@index([workspaceId, createdAt], map: "operating_command_log_workspace_time_idx")
  @@index([workspaceId, riskLevel, createdAt], map: "operating_command_log_risk_idx")
  @@map("operating_command_logs")
}

model TimeSpine {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  workspace   Workspace  @relation("WorkspaceTimeSpine", fields: [workspaceId], references: [id], onDelete: Cascade)
  onDate      DateTime   @map("on_date") @db.Date
  track       SpineTrack
  refTable    String     @map("ref_table")
  refId       String     @map("ref_id") @db.Uuid
  title       String
  actorIds    String[]   @map("actor_ids") @db.Uuid
  /// 佔用強度，餵 heatmap 與衝期規則
  weight      Int        @default(1)
  state       SpineState @default(PLANNED)
  star        Boolean    @default(false)
  projectId   String?    @map("project_id") @db.Uuid
  derivedFrom String?    @map("derived_from")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([refTable, refId, onDate], map: "time_spine_ref_key")
  @@index([workspaceId, onDate], map: "time_spine_workspace_date_idx")
  @@index([workspaceId, track, onDate], map: "time_spine_workspace_track_idx")
  @@map("time_spine")
}

// ─── 專案工作區五大資源（PLN-075 S2 · Migration ①＋②）───────────────────────
//
// Owner 決策（PLN-075 §S0）在這一段的落點：
//   OD-D 會議＝擴充 `Occasion` 加 `folderId?`，**不另開 ProjectMeeting**
//   OD-E `OperatingAsset` 是專案檔案唯一的家，`FileAsset`／`MediaAsset` 完全不動
//   OD-F 聊天室新建「一列一訊息」模型，`OperatingThread` 完全保留不動
//
// 全部 additive：沒有刪欄、沒有改必填、沒有改型別。

/// 資料夾的用途。
///
/// 為什麼是 enum 而不是 `role: String`：enum 讓「哪些 kind 禁止對客戶可見」
/// 這條規則在 schema 層就看得見，而 `check-migration-coverage.mjs` 會逐 enum 比對。
/// 代價是新增一種資料夾要一次 migration —— `GENERIC` 已涵蓋 99% 的新需求。
enum ProjectFolderKind {
  /// 硬碟根。每個專案恰好一個，`isSystem = true`，`parentId = null`
  ROOT
  /// 收件匣。每個專案恰好一個；任何沒有指定資料夾的上傳都落這裡（OD-E／D-E）
  INBOX
  /// 一般資料夾
  GENERIC
  /// 提案（開案前）
  PROPOSAL
  /// 回簽合約／報價單。**禁止**被設為 CLIENT_VISIBLE
  CONTRACT
  /// 里程碑交付夾。由 `ProjectMilestone.folderId` 連結（是連結，不是包含）
  MILESTONE
  /// 一個資料夾＝一場會議。屬性在 `Occasion`（OD-D）
  MEETING
  /// 對客戶共用（Owner 既有慣例 `[共用]`）
  SHARED
  /// 內部不得提供客戶。**禁止**被設為 CLIENT_VISIBLE
  INTERNAL
  /// 修改需求 —— 下一期的入口（可綁 `ProjectPhaseCycle`）
  REVISION
  /// 素材庫
  MATERIAL
  /// 專案財務。預設 INTERNAL_ONLY
  FINANCE
  /// 聊天室附件落點
  CHAT_DROP
  /// LINE 媒體落點（OD-H：本階段不做，只留停用的佔位）
  LINE_DROP

  @@map("project_folder_kind")
}

/// 可見性是三級，不是兩級（INTEGRATION-DECISION §5）。
///
/// 第三級不是潔癖：`05/商城專案資訊.docx` 是明文帳號密碼。若它建了
/// `OperatingAsset.extractedText`，任何有席位的人搜「密碼」就看得到 ——
/// **資料夾權限擋不住全文搜尋**，所以「不建索引」必須是自己的一級。
enum ProjectFolderVisibility {
  /// 客戶可見
  CLIENT_VISIBLE
  /// 內部 · 禁對客戶（預設：對客戶一律 deny-by-default）
  INTERNAL_ONLY
  /// 最高敏感 · 不建全文索引
  RESTRICTED_NO_INDEX

  @@map("project_folder_visibility")
}

/// 階段的種類。既有的 `ProjectPhase`（DISCOVERY/PLANNING/EXECUTION/REVIEW/MAINTENANCE）
/// 是另一套詞彙，仍被 `Project.phase` 與 v5 工作台的 `phases` 集合使用，不動它。
enum ProjectStageKind {
  PROPOSAL
  CONTRACT
  EXECUTION
  ACCEPTANCE
  CLOSING
  /// 使用者自訂的流程格
  CUSTOM

  @@map("project_stage_kind")
}

/// 專案生命週期。`Project.lifecycleStage` 用它。
enum ProjectLifecycleStage {
  PROPOSING
  CONTRACTED
  EXECUTING
  ACCEPTANCE
  CLOSED

  @@map("project_lifecycle_stage")
}

enum ProjectPhaseCycleStatus {
  PLANNED
  ACTIVE
  ACCEPTED
  CLOSED
  CANCELLED

  @@map("project_phase_cycle_status")
}

/// TODO 與審核是同一張表的兩種 kind，不是兩張表。
enum ProjectTaskKind {
  TODO
  REVIEW

  @@map("project_task_kind")
}

enum ProjectReviewState {
  PENDING
  IN_REVIEW
  PASSED
  CHANGES_REQUESTED
  WAIVED

  @@map("project_review_state")
}

enum ProjectChatChannelKind {
  /// 專案主頻道
  MAIN
  /// 主題討論
  TOPIC
  /// LINE 群鏡射（唯讀；OD-H 本階段不接）
  LINE_MIRROR
  /// 客戶可見（未來 Client Portal 用；本階段不開）
  CLIENT

  @@map("project_chat_channel_kind")
}

enum ProjectChatOrigin {
  /// 站內送出
  APP
  /// LINE bot 即時導入（OD-H 本階段不做）
  LINE
  /// LINE 匯出檔匯入的歷史
  LINE_IMPORT
  /// 系統訊息（階段完成、里程碑達成）
  SYSTEM

  @@map("project_chat_origin")
}

/// 專案雲端硬碟的資料夾。一棵樹、一個 `kind`、三級 `visibility`。
///
/// 為什麼每個專案一定有一個 ROOT 列：Postgres 的 UNIQUE 視 NULL 為互異，
/// 所以 `@@unique([parentId, nameNormalized])` 擋不住兩個 `parentId = null` 的同名資料夾。
/// 給每個專案一個真的根之後，其餘資料夾的 `parentId` 一律非空，同層同名才真的被擋下來。
///
/// 收件匣是**真資料夾**（`kind = INBOX`），不是虛擬視圖、不是旗標：
/// 每個 asset 永遠恰好屬於一個 folderId，listing 只有一種形狀、麵包屑永遠畫得出來。
model ProjectFolder {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String                  @map("project_id") @db.Uuid
  project     Project                 @relation("ProjectFolders", fields: [projectId], references: [id], onDelete: Cascade)
  /// `OperatingAsset.workspaceId` 是 NOT NULL，而資料夾與夾內檔案必須同一個工作區，
  /// 所以這裡也 NOT NULL。`Project.workspaceId` 是可空的 —— 啟用硬碟時由服務層的
  /// `ensureProjectWorkspace()` 先把它補上，那是一個具名步驟，不是隱性副作用。
  /// 與 operating_* 諸表一致地不加外鍵。
  workspaceId String                  @map("workspace_id") @db.Uuid
  /// 工作台的業務 id（`FLD-…`）。沒有它，讀取路徑就還原不回工作台需要的 id。
  workbenchRef String?                @map("workbench_ref")

  parentId    String?                 @map("parent_id") @db.Uuid
  parent      ProjectFolder?          @relation("ProjectFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    ProjectFolder[]         @relation("ProjectFolderTree")

  kind        ProjectFolderKind       @default(GENERIC)
  visibility  ProjectFolderVisibility @default(INTERNAL_ONLY)
  name        String
  /// 小寫 ＋ NFC 正規化後的名字，只用來做同層唯一性。顯示一律用 `name`。
  nameNormalized String               @map("name_normalized")
  /// 具體化路徑 `/<rootId>/<id>/`：子樹查詢 startsWith，搬移一次 UPDATE ... LIKE。
  /// 不用 ltree：Prisma 沒有該型別，整張表會退回 `Unsupported()` 與 raw query。
  path        String                  @default("/")
  depth       Int                     @default(0)
  sortOrder   Int                     @default(0) @map("sort_order")
  /// 系統資料夾（ROOT／INBOX／CHAT_DROP）：不可改名、不可刪除、不可搬移
  isSystem    Boolean                 @default(false) @map("is_system")
  /// team＝專案成員可見；personal＝只有建立者（與 `OperatingAsset.space` 同語意）
  space       String                  @default("team")
  /// Profile.id。對不到人時留空 —— 不加外鍵，與 operating_* 一致。
  createdByProfileId String?          @map("created_by_profile_id") @db.Uuid
  note        String?
  /// 只軟刪：資料夾被引用過（里程碑交付夾、會議資料夾）就不能真的消失。
  deletedAt   DateTime?               @map("deleted_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  milestones  ProjectMilestone[]      @relation("MilestoneFolder")
  occasion    Occasion?               @relation("OccasionFolder")

  @@unique([parentId, nameNormalized], map: "project_folders_sibling_name_unique")
  @@index([projectId, kind], map: "project_folders_project_kind_idx")
  @@index([projectId, path], map: "project_folders_project_path_idx")
  @@index([workspaceId, workbenchRef], map: "project_folders_ref_idx")
  @@map("project_folders")
}

/// 「期」：一個交付週期，通常對應一份合約（一期／二期／三期）。
///
/// 為什麼不是 `ProjectPhaseNode` 上的一個整數欄位：二期帶著自己的合約、預算與起訖，
/// 那是一個實體。做成整數欄位的話這些東西會散在別處，再靠 cycleNo 串回來。
/// 加一期＝插一列，不需要 migration、不需要改 enum。
model ProjectPhaseCycle {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String                  @map("project_id") @db.Uuid
  project     Project                 @relation("ProjectPhaseCycles", fields: [projectId], references: [id], onDelete: Cascade)
  workspaceId String?                 @map("workspace_id") @db.Uuid
  workbenchRef String?                @map("workbench_ref")

  /// 1, 2, 3 …。顯示成「一期」「二期」。
  ordinal     Int
  /// 使用者可覆寫的標籤（`二期：南區擴充`）。空＝依 ordinal 自動顯示。
  title       String?
  /// 這一期依據哪份合約。可空：提案階段還沒有合約。
  contractId  String?                 @map("contract_id") @db.Uuid
  contract    OperatingContract?      @relation("ContractPhaseCycles", fields: [contractId], references: [id], onDelete: SetNull)

  /// 可空而不是 default 0：「這一期還沒編預算」與「這一期預算是 0」不是同一件事。
  budgetAmount Int?                   @map("budget_amount")
  startOn     DateTime?               @map("start_on") @db.Date
  endOn       DateTime?               @map("end_on") @db.Date
  status      ProjectPhaseCycleStatus @default(PLANNED)
  note        String?
  deletedAt   DateTime?               @map("deleted_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  stages      ProjectPhaseNode[]      @relation("PhaseCycleStages")

  @@unique([projectId, ordinal], map: "project_phase_cycles_project_ordinal_unique")
  @@index([projectId, status], map: "project_phase_cycles_project_status_idx")
  @@index([workspaceId, workbenchRef], map: "project_phase_cycles_ref_idx")
  @@map("project_phase_cycles")
}

/// 專案聊天室的頻道。
///
/// 為什麼需要頻道這一層：每個綁定的 LINE 群要變成同一個閱讀器裡的一個頻道
/// （`kind = LINE_MIRROR`），才能與站內訊息共用同一種訊息形狀、同一個附件管線、
/// 同一套權限。沒有頻道層，LINE 就得另造一套訊息表。
model ProjectChatChannel {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String                 @map("project_id") @db.Uuid
  project     Project                @relation("ProjectChatChannels", fields: [projectId], references: [id], onDelete: Cascade)
  workspaceId String?                @map("workspace_id") @db.Uuid
  workbenchRef String?               @map("workbench_ref")

  kind        ProjectChatChannelKind @default(TOPIC)
  name        String
  topic       String?
  /// LINE_MIRROR 一律 true：站內不回傳訊息到 LINE。
  isReadOnly  Boolean                @default(false) @map("is_read_only")
  isArchived  Boolean                @default(false) @map("is_archived")
  sortOrder   Int                    @default(0) @map("sort_order")
  /// 衍生計數，由服務層單一 writer 維護（與 TimeSpine 同模式）。
  messageCount Int                   @default(0) @map("message_count")
  lastMessageAt DateTime?            @map("last_message_at")
  /// 附件落點（`kind = CHAT_DROP` 的資料夾）。可空＝附件直接落 INBOX。
  dropFolderId String?               @map("drop_folder_id") @db.Uuid
  createdByProfileId String?         @map("created_by_profile_id") @db.Uuid
  deletedAt   DateTime?              @map("deleted_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  messages    ProjectChatMessage[]   @relation("ChannelMessages")

  @@index([projectId, kind, isArchived], map: "project_chat_channels_project_kind_idx")
  @@index([workspaceId, workbenchRef], map: "project_chat_channels_ref_idx")
  @@map("project_chat_channels")
}

/// **一列一訊息**（OD-F）。
///
/// 為什麼不是 `OperatingThread.messages Json`：Json 陣列代表每送一則訊息重寫整列，
/// 兩人同時講話會互相覆蓋；而且每則訊息沒有自己的 id，就無法回覆特定訊息、
/// 無法掛附件外鍵、無法被 @ 引用、無法建索引搜尋。`OperatingThread` 保留不動。
///
/// 欄位形狀抄 `OperatingComment`：`authorProfileId` ＋ `authorKey` 雙身分、
/// `replyToId`、`meta Json`、`deletedAt` 軟刪（被引用過就不能真的消失）。
model ProjectChatMessage {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId   String             @map("channel_id") @db.Uuid
  channel     ProjectChatChannel @relation("ChannelMessages", fields: [channelId], references: [id], onDelete: Cascade)
  /// 去正規化，讓「這個專案所有訊息」與授權檢查不必 join。
  projectId   String             @map("project_id") @db.Uuid
  project     Project            @relation("ProjectChatMessages", fields: [projectId], references: [id], onDelete: Cascade)
  workspaceId String?            @map("workspace_id") @db.Uuid
  workbenchRef String?           @map("workbench_ref")

  /// Profile.id；對不到人時留空，身分仍由 authorKey／authorExternalRef 保住。
  authorProfileId String?        @map("author_profile_id") @db.Uuid
  /// 席位字串（yz / lily）
  authorKey   String?            @map("author_key")
  /// LINE userId 或匯出檔裡的顯示名稱 —— 對不到站內身分的外部作者
  authorExternalRef String?      @map("author_external_ref")
  authorDisplayName String?      @map("author_display_name")

  origin      ProjectChatOrigin  @default(APP)
  /// 外部唯一鍵：LINE 的 messageId，或匯入檔的 sha256(時間|作者|內容)。去重用。
  externalRef String?            @map("external_ref")

  body        String
  /// text | image | video | audio | file | sticker | location | system
  messageType String             @default("text") @map("message_type")
  /// 匯出檔的占位訊息（`[照片]`）—— 有訊息但永遠沒有 bytes
  isPlaceholder Boolean          @default(false) @map("is_placeholder")
  /// 匯入的歷史（UI 以分隔線與底色區分）
  isHistorical Boolean           @default(false) @map("is_historical")

  replyToId   String?            @map("reply_to_id") @db.Uuid
  replyTo     ProjectChatMessage?  @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ProjectChatMessage[] @relation("ChatMessageReplies")

  /// @ 到的人（Profile.id）與引用到的物件 refCode。形狀仍在演進，先整包存。
  mentions    Json               @default("[]")
  /// { lineQuotedMessageId, lineStickerId, importLineNo, … } 來源細節
  meta        Json               @default("{}")

  /// 真正發生的時刻（LINE timestamp／匯出檔的時間），與 createdAt 可能不同天。
  sentAt      DateTime           @map("sent_at")
  editedAt    DateTime?          @map("edited_at")
  deletedAt   DateTime?          @map("deleted_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  attachments ProjectChatAttachment[] @relation("MessageAttachments")

  @@unique([channelId, externalRef], map: "project_chat_messages_channel_external_unique")
  @@index([channelId, sentAt], map: "project_chat_messages_channel_time_idx")
  @@index([projectId, sentAt], map: "project_chat_messages_project_time_idx")
  @@index([replyToId], map: "project_chat_messages_reply_idx")
  @@index([workspaceId, workbenchRef], map: "project_chat_messages_ref_idx")
  @@map("project_chat_messages")
}

/// 訊息 ↔ 檔案。
///
/// 為什麼不是 `assetIds String[]`：反向查詢（「這個檔案在哪些訊息被提到」）是
/// 物件索引與檔案詳細抽屜都要的功能，而 Postgres 的陣列包含查詢需要 GIN 索引，
/// Prisma 宣告不了。`assetId` 不加外鍵，與 `OperatingAsset` 整張表的慣例一致。
model ProjectChatAttachment {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String             @map("message_id") @db.Uuid
  message   ProjectChatMessage @relation("MessageAttachments", fields: [messageId], references: [id], onDelete: Cascade)
  /// OperatingAsset.id
  assetId   String             @map("asset_id") @db.Uuid
  sortOrder Int                @default(0) @map("sort_order")
  createdAt DateTime           @default(now()) @map("created_at")

  @@unique([messageId, assetId], map: "project_chat_attachments_unique")
  @@index([assetId], map: "project_chat_attachments_asset_idx")
  @@map("project_chat_attachments")
}
