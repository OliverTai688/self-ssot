  REJECTED
  COMPLETED

  @@map("agent_message_status")
}

model WorkflowRule {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  fromAgent        String         @map("from_agent")
  intent           String
  conditions       String?
  toAgent          String         @map("to_agent")
  targetIntent     String         @map("target_intent")
  mode             String         @default("broadcast")
  delaySeconds     Int            @default(0) @map("delay_seconds")
  requiresApproval Boolean        @default(false) @map("requires_approval")
  enabled          Boolean        @default(true)
  priority         Int            @default(100)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  messages AgentMessage[]

  @@map("workflow_rules")
}

model AgentMessage {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  traceId         String             @map("trace_id") @db.Uuid
  parentMessageId String?            @map("parent_message_id") @db.Uuid
  parent          AgentMessage?      @relation("MessageChain", fields: [parentMessageId], references: [id], onDelete: SetNull)
  children        AgentMessage[]     @relation("MessageChain")
  fromAgent       String             @map("from_agent")
  toAgent         String             @map("to_agent")
  intent          String
  payload         Json               @default("{}")
  status          AgentMessageStatus @default(PENDING)
  ruleId          String?            @map("rule_id") @db.Uuid
  rule            WorkflowRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  summary         String?
  errorMessage    String?            @map("error_message")
  createdAt       DateTime           @default(now()) @map("created_at")
  completedAt     DateTime?          @map("completed_at")

  @@map("agent_messages")
}

model AcademicPerson {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable pending TENANT-003 backfill migration; every future write must set this.
  // See ARC-033 and RES-020 — a global, ownerless row here would be visible to every tenant.
  ownerId               String?  @db.Uuid @map("owner_id")
  owner                 Profile? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String
  academicRole          String?  @map("academic_role")
  affiliation           String?
  country               String?
  profileUrl            String?  @map("profile_url")
  researchAreas         String[] @default([]) @map("research_areas")
  importantWorks        String[] @default([]) @map("important_works")
  relatedEvents         String[] @default([]) @map("related_events")
  backgroundSummary     String?  @map("background_summary")
  relevanceToMyResearch String?  @map("relevance_to_my_research")
  conversationAngles    String[] @default([]) @map("conversation_angles")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("academic_people")
}

enum AgentCommandType {
  SINGLE_AGENT
  TEAM_GROUP

  @@map("agent_command_type")
}

model AgentCommand {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId            String           @unique @map("operation_id")
  label                  String
  agentInstructionLabel  String           @map("agent_instruction_label")
  moduleKey              String           @map("module_key")
  ownerAgent             String           @map("owner_agent")
  targetModule           String           @map("target_module")
  riskLevel              String           @map("risk_level")
  approvalLevel          String           @map("approval_level")
  dataVisibilityLevel    String           @map("data_visibility_level")
  scopes                 String[]         @default([])
  allowedModes           String[]         @default(["dry_run"])
  uiEntrySurface         String           @map("ui_entry_surface")
  proposalOutputs        String[]         @default([]) @map("proposal_outputs")
  agentProposalOutputs   String[]         @default([]) @map("agent_proposal_outputs")
  blockedWrites          String[]         @default([]) @map("blocked_writes")
  agentBlockedWrites     String[]         @default([]) @map("agent_blocked_writes")
  sourceRefs             String[]         @default([]) @map("source_refs")
  promptTemplate         String?          @map("prompt_template")
  stages                 Json             @default("[]") @map("stages")
