  @@index([moduleKey, commandType])
  @@map("agent_commands")
}

model Skill {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String?     @map("workspace_id") @db.Uuid
  workspace          Workspace?  @relation("WorkspaceSkills", fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  instructions       String
  scope              SkillScope  @default(WORKSPACE)
  status             SkillStatus @default(ACTIVE)
  createdByProfileId String      @map("created_by_profile_id") @db.Uuid
  createdBy          Profile     @relation("SkillCreatedBy", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([workspaceId, status], map: "skills_workspace_status_idx")
  @@map("skills")
}

/// 使用者自己的營運工作台設定（基礎／個人）。一列一個 key，值以 Json 保存，
/// 可用的 key 與型別由 src/lib/settings/operating-settings.catalog.ts 定義。
model UserSetting {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String       @map("profile_id") @db.Uuid
  profile   Profile      @relation("UserSettingProfile", fields: [profileId], references: [id], onDelete: Cascade)
  scope     SettingScope
  key       String
  value     Json
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([profileId, scope, key])
  @@index([profileId, scope], map: "user_settings_profile_scope_idx")
  @@map("user_settings")
}

/// 組織級設定：只有具負責人席位的帳號可以寫，所有成員都讀得到（這些值會影響他們看到什麼）。
/// orgKey 目前固定為單一組織，保留欄位是為了之後真的多租戶時不用再改主鍵。
model OrganizationSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgKey      String   @map("org_key")
  key         String
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedBy   Profile? @relation("OrganizationSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([orgKey, key])
  @@index([orgKey], map: "organization_settings_org_key_idx")
  @@map("organization_settings")
}

// ─── 營運三軌與 time_spine（ARC-041 · PLN-073 T5）─────────────────────────────
// 專案軌沿用既有的 Project → ProjectPhaseNode → ProjectMilestone，往下補 Objective；
// 節奏軌與行政／活動軌是新的。time_spine 是衍生索引，由服務層單一 writer 維護。

enum RhythmKind {
  // 會議或習慣：standup / 1:1 / 回顧 / 學習日 —— 計入履行率
  RITUAL
  // 週期性行政義務：發薪 / 勞健保 / 報稅 —— 進日曆與提醒，但不計履行率
  ADMIN

  @@map("rhythm_kind")
}

enum RhythmScope {
  COMPANY
  PERSONAL

  @@map("rhythm_scope")
}

enum RhythmSessionState {
  DONE
  SKIP
  MOVED

  @@map("rhythm_session_state")
}

enum OccasionCategory {
  COMPANY_EVENT
  CLIENT_MEETING
  TRAVEL
  BIRTHDAY
  VISIT
  ADMIN

  @@map("occasion_category")
}

enum OperatingMediaKind {
  AUDIO
  PHOTO
  DOC

  @@map("operating_media_kind")
}

enum SpineTrack {
  PROJECT
  RHYTHM
  OCCASION

  @@map("spine_track")
}

enum SpineState {
  PLANNED
  DONE
  LATE
  MISSED
  SKIPPED

  @@map("spine_state")
}

/// 里程碑底下的「怎樣才算做到」。達成率由底下的 ProjectTask 推算。
model ProjectObjective {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  milestoneId String           @map("milestone_id") @db.Uuid
  milestone   ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title       String
  workbenchRef String? @map("workbench_ref")

  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tasks ProjectTask[]

  @@index([milestoneId], map: "project_objectives_milestone_idx")
  @@map("project_objectives")
}

/// 日常節奏的規則本體。未來實例不預存，查詢期由 RRULE 展開（ARC-041 §2.1）。
model Rhythm {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  workspace   Workspace   @relation("WorkspaceRhythms", fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  workbenchRef String? @map("workbench_ref")

  kind        RhythmKind  @default(RITUAL)
  scope       RhythmScope @default(COMPANY)
  ownerIds    String[]    @map("owner_ids") @db.Uuid
  /// RFC 5545，例 FREQ=WEEKLY;INTERVAL=2;BYDAY=TU
  rrule       String
  /// 天粒度、當地日語意；夏令時間下「每週五 13:00」仍是當地的 13:00
  dtstart     DateTime    @map("dtstart") @db.Date
  until       DateTime?   @db.Date
  timeOfDay   String?     @map("time_of_day")
  timezone    String      @default("Asia/Taipei")
  expectMedia String[]    @map("expect_media")
  /// 由契約條文或法規推導 —— 帶值者不可編輯或刪除
  derivedFrom String?     @map("derived_from")
  remind      String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  sessions RhythmSession[]

  @@index([workspaceId, kind, active], map: "rhythms_workspace_kind_idx")
  @@map("rhythms")
}

/// 節奏的單次實例。只有「發生了事情」才落一筆 —— 等同 iCalendar 的 RECURRENCE-ID 覆寫。
model RhythmSession {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rhythmId       String             @map("rhythm_id") @db.Uuid
  rhythm         Rhythm             @relation(fields: [rhythmId], references: [id], onDelete: Cascade)
  /// 規則算出的原始日期，也是覆寫鍵
  occurrenceDate DateTime           @map("occurrence_date") @db.Date
  state          RhythmSessionState
  movedTo        DateTime?          @map("moved_to") @db.Date
  note           String?
  spawnedTaskIds String[]           @map("spawned_task_ids") @db.Uuid
  recordedById   String?            @map("recorded_by_id") @db.Uuid
  recordedAt     DateTime           @default(now()) @map("recorded_at")

  mediaItems OperatingMedia[]

  @@unique([rhythmId, occurrenceDate], map: "rhythm_sessions_occurrence_key")
  @@index([rhythmId, occurrenceDate], map: "rhythm_sessions_rhythm_date_idx")
  @@map("rhythm_sessions")
}

/// 行政／活動：一次性時間點或短區間，重點在事前準備與事後留下的素材。
model Occasion {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  workspace      Workspace        @relation("WorkspaceOccasions", fields: [workspaceId], references: [id], onDelete: Cascade)
  title          String
  /// 工作台的業務 id（PRJ-2026-004 之類）。主鍵是由它推導的 UUIDv5，而那是單向的——
  /// 沒有這一欄就讀不回工作台需要的 id，關聯（issue.p、milestone.projectId）也接不回去。
  workbenchRef String? @map("workbench_ref")

  category       OccasionCategory @default(COMPANY_EVENT)
  onDate         DateTime         @map("on_date") @db.Date
  endOn          DateTime?        @map("end_on") @db.Date
  startsAt       DateTime?        @map("starts_at")
  endsAt         DateTime?        @map("ends_at")
  place          String?
  actorIds       String[]         @map("actor_ids") @db.Uuid
  externalGuests String?          @map("external_guests")
  star           Boolean          @default(false)
  projectId      String?          @map("project_id") @db.Uuid
  project        Project?         @relation("ProjectOccasions", fields: [projectId], references: [id], onDelete: SetNull)
  /// [{ t, done, dueOn?, taskId? }]
  prep           Json             @default("[]")
  recap          String?
  derivedFrom    String?          @map("derived_from")
  remind         String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  mediaItems OperatingMedia[]

  @@index([workspaceId, onDate], map: "occasions_workspace_date_idx")
  @@index([projectId], map: "occasions_project_idx")
  @@map("occasions")
}

/// 節奏紀錄與活動的素材。檔案本體沿用 SCH-005 的 R2 儲存。
model OperatingMedia {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       OperatingMediaKind
  url        String
  filename   String
  bytes      Int                @default(0)
  transcript String?
  sessionId  String?            @map("session_id") @db.Uuid
  session    RhythmSession?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  occasionId String?            @map("occasion_id") @db.Uuid
  occasion   Occasion?          @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([sessionId], map: "operating_media_session_idx")
  @@index([occasionId], map: "operating_media_occasion_idx")
  @@map("operating_media")
}

/// 三軌匯流的扁平索引。只索引「已具體化」的東西；節奏的未來實例由查詢期展開後合併。
/// 衍生資料，由 src/lib/services/operating-spine.service.ts 單一 writer 維護，
/// 並由 scripts/reconcile-time-spine.ts 定期對帳（ARC-041 §3）。
// ─── 營運工作台的日常協作資料（SCH-008 · PLN-074 M2）────────────────────────
// Project 由 Work 模組擁有；營運專屬欄位放 1:1 側表（SCH-008 §3 決定 C）。

/// 圓展營運專案的專屬欄位。主鍵即 projectId：1:1 共用主鍵，沒有第二個 id 要對齊。
model OperatingProjectProfile {
  projectId       String         @id @map("project_id") @db.Uuid
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client          String?
  workbenchRef String? @map("workbench_ref")

  goalId          String?        @map("goal_id") @db.Uuid
  goal            OperatingGoal? @relation("OperatingGoalProjects", fields: [goalId], references: [id], onDelete: SetNull)
  /// 產品交付型 / 行銷服務型 / 未確認
  engagementType  String?        @map("engagement_type")
  /// 工作台的原始狀態（商機 / 進行中 / 驗收中）；ProjectStatus 是給 Work 模組的粗分類
  operatingStatus String         @default("商機") @map("operating_status")
  /// 獎金率與上限是專案設定，不是帳務憑證；M4 之前不據以產生任何應付金額
  bonusRatePct    Int            @default(0) @map("bonus_rate_pct")
  bonusCapPct     Int            @default(0) @map("bonus_cap_pct")
  budgetAmount    Int            @default(0) @map("budget_amount")
  evidenceRepoTag String?        @map("evidence_repo_tag")
  startedOn       DateTime?      @map("started_on") @db.Date
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([goalId], map: "operating_project_profiles_goal_idx")
  @@map("operating_project_profiles")
}

/// 年度／季目標。公司層級（SCH-008 §8）。
model OperatingGoal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  title       String
  period      String
  workbenchRef String? @map("workbench_ref")

  progressPct Int      @default(0) @map("progress_pct")
  warning     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projects OperatingProjectProfile[] @relation("OperatingGoalProjects")

  @@index([workspaceId], map: "operating_goals_workspace_idx")
  @@map("operating_goals")
}

/// 書寫式日誌。一人一天一筆。
model OperatingJournalEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Profile.id，與 rhythm_sessions.recorded_by_id 一樣不設外鍵：停用成員時保留歷史作者
  authorId    String   @map("author_id") @db.Uuid
  onDate      DateTime @map("on_date") @db.Date
  title       String?
  /// typed block 陣列。block 種類仍在演進，早期正規化會讓每次 UI 調整都變成 migration。
  blocks      Json     @default("[]")
  /// company | private —— private 只有作者讀得到，即使同 workspace（契約 §18）
  visibility  String   @default("company")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, authorId, onDate], map: "operating_journal_author_day_key")
  @@index([workspaceId, onDate], map: "operating_journal_workspace_date_idx")
  @@map("operating_journal_entries")
}

/// 日誌行內留言、物件留言、一般留言合一。
model OperatingComment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// Profile.id；對不到人時留空，作者身分仍由 authorKey 保住
  authorId    String?   @map("author_id") @db.Uuid
  /// 席位字串（yz / lily）。工作台顯示的是這個，不是 uuid
  authorKey   String?   @map("author_key")
  workbenchRef String?  @map("workbench_ref")
  /// journal | line | object
  targetType  String    @map("target_type")
  targetRef   String    @map("target_ref")
  parentId    String?   @map("parent_id") @db.Uuid
  body        String
  /// 工作台顯示用的時間字串（'10:20'）與 line 留言的 blockId／day
  meta        Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 軟刪除：留言被引用過就不能真的消失，否則被引用的那一頭會指向空白
  deletedAt   DateTime? @map("deleted_at")

  @@index([workspaceId, targetType, targetRef], map: "operating_comments_target_idx")
  @@index([parentId], map: "operating_comments_parent_idx")
  @@map("operating_comments")
}

/// 決議紀錄。
/// 日誌裡的請求與回覆流。options／replies／nudges 形狀仍在演進，先整包存。
model OperatingRequest {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  workbenchRef String?  @map("workbench_ref")
  fromKey      String?  @map("from_key")
  toKey        String?  @map("to_key")
  onDate       DateTime? @map("on_date") @db.Date
  blockId      String?  @map("block_id")
  text         String
  kind         String   @default("ask")
  sentAt       DateTime? @map("sent_at")
  payload      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, onDate], map: "operating_requests_workspace_date_idx")
  @@map("operating_requests")
}

model OperatingDecision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  authorId    String?  @map("author_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  title       String
  workbenchRef String? @map("workbench_ref")

  body        String?
  decidedOn   DateTime? @map("decided_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, decidedOn], map: "operating_decisions_workspace_date_idx")
  @@map("operating_decisions")
}

// ─── Evidence、承諾、容量（SCH-008 · PLN-074 M3）─────────────────────────────

/// 契約條文。條文陣列用 Json：它們是文件的一部分，不會被單獨查詢或改寫。
model OperatingDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// 內部 / 外部
  direction   String
  title       String
  workbenchRef String? @map("workbench_ref")

  /// [{ id, ref, text }]
  clauses     Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId], map: "operating_documents_workspace_idx")
  @@map("operating_documents")
}

/// 由條文推導的承諾。履行紀錄存 Json —— 比對發生在承諾這一層，
/// 拆成子表會讓單次 commit 產生兩種列變更，而 diff 只認得一種。
model OperatingCommitment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  documentRef String?  @map("document_ref")
  clauseRef   String?  @map("clause_ref")
  direction   String
  title       String
  workbenchRef String? @map("workbench_ref")

  ownerKey    String?  @map("owner_key")
  status      String
  cadence     String?
  /// [{ d, t, src, ok }] 履行 log。空白不代表沒做，代表沒有紀錄。
  logs        Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status], map: "operating_commitments_workspace_status_idx")
  @@map("operating_commitments")
}

/// 專案聊天室。
model OperatingThread {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  title       String
  workbenchRef String? @map("workbench_ref")

  closed      Boolean  @default(false)
  /// [{ w, ts, x }]
  messages    Json     @default("[]")
  closeNote   Json?    @map("close_note")
  files       String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, projectId], map: "operating_threads_workspace_project_idx")
  @@map("operating_threads")
}

/// Evidence Repo：一個專案一份。檔案本體仍在 R2（SCH-005），這裡存目錄與版本。
model OperatingEvidenceRepo {
  projectId   String   @id @map("project_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  version     String   @default("v0.1")
  workbenchRef String? @map("workbench_ref")

  frozen      Boolean  @default(false)
  readme      String?
  /// [{ v, t, st }]
  versions    Json     @default("[]")
  /// [{ f, dir, note, ok }]
  tree        Json     @default("[]")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId], map: "operating_evidence_repos_workspace_idx")
  @@map("operating_evidence_repos")
}

/// 容量配置與出勤，一人一列。
/// 以席位字串（yz / lily）而不是 Profile uuid 當鍵：席位是工作台的身分概念，
/// 而且 Profile 還沒建立時也要能存 —— 對不到人就整筆存不了會是更糟的失敗。
model OperatingCapacityPlan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorKey    String   @map("actor_key")
  /// [[label, pct, target]]
  allocations Json     @default("[]")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, actorKey], map: "operating_capacity_actor_key")
  @@map("operating_capacity_plans")
}

model OperatingTimesheet {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorKey    String   @map("actor_key")
  /// [{ wk, from, days, est, st, conf }] 分鐘粒度；由本人確認，不由系統推估
  weeks       Json     @default("[]")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, actorKey], map: "operating_timesheet_actor_key")
  @@map("operating_timesheets")
}

// ─── 帳務（SCH-008 §5 · PLN-074 M4）──────────────────────────────────────────
// 這些表存的是使用者自己輸入的數字。database 模式不載入任何 fixture，所以原型裡
// 那些合成的費率與金額不會進到這裡 —— 這正是 SCH-008 §5 當初要避免的事。
// 規則（獎金公式、稅務、薪資級距）仍不在系統裡，工作台是在前端試算。

model OperatingTransaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  onDate      DateTime @map("on_date") @db.Date
  title       String
  workbenchRef String? @map("workbench_ref")

  projectRef  String?  @map("project_ref")
  category    String?
  /// 未稅金額，支出為負。整數避免浮點誤差累積在對帳上。
  amount      Int      @default(0)
  /// 使用者輸入的算式（=SUM(D1:D3) 之類），保留原文才能重新檢查怎麼算出來的
  formula     String?
  /// 代收代付：不計入可分配毛利
  passThrough Boolean  @default(false) @map("pass_through")
  /// 憑證種類清單（發票／合約／匯款單）
  vouchers    String[]
  /// 憑證檔案（RES-032）：[{ objectKey, name, type, bytes, at, by }]。bytes 在 R2，這裡只留 key。
  /// 另開一欄而不是把 vouchers 改型別：既有列不需要搬資料，種類標籤與檔案可以各自存在。
  attachments Json     @default("[]")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, onDate], map: "operating_transactions_workspace_date_idx")
  @@map("operating_transactions")
}

model OperatingReimbursement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorKey    String?  @map("actor_key")
  title       String
  workbenchRef String? @map("workbench_ref")

  amount      Int      @default(0)
  /// 待送 / 已核 / 已付
  status      String   @default("待送")
  onDate      DateTime? @map("on_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status], map: "operating_reimbursements_workspace_status_idx")
  @@map("operating_reimbursements")
}

/// 銀行明細。matchedRef 指向交易，是對帳的結果而不是外鍵：
/// 對不上的那幾筆正是對帳要看的東西，不能因為外鍵約束而存不進來。
model OperatingBankEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  onDate      DateTime @map("on_date") @db.Date
  title       String
  workbenchRef String? @map("workbench_ref")

  amount      Int      @default(0)
  matchedRef  String?  @map("matched_ref")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId, onDate], map: "operating_bank_entries_workspace_date_idx")
  @@map("operating_bank_entries")
}

/// 收件匣的一筆單據（RES-032 §5.2 生命週期 ①②）。
///
/// 收單面只能把東西推到「待歸帳」，不能直接產生交易：同事不需要懂類別。
/// 記帳者歸帳時才建立 OperatingTransaction，並把 postedRef 指回去。
/// 代墊的單據會同時有一筆報帳（reimbRef），核准後才出現在待歸帳。
model OperatingIntakeItem {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  workbenchRef String?   @map("workbench_ref")
  actorKey     String?   @map("actor_key")
  title        String
  /// 缺金額就是 null：收件匣要顯示「缺金額」，不能用 0 假裝有值
  amount       Int?
  onDate       DateTime? @map("on_date") @db.Date
  projectRef   String?   @map("project_ref")
  /// draft（缺資料）/ unfiled（待歸帳）/ posted（已入帳）/ discarded
  status       String    @default("draft")
  /// { objectKey, name, type, bytes }；bytes 走 R2
  file         Json?
  reimbRef     String?   @map("reimb_ref")
  postedRef    String?   @map("posted_ref")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, status], map: "operating_intake_items_workspace_status_idx")
  @@index([workspaceId, workbenchRef], map: "operating_intake_items_ref_idx")
  @@map("operating_intake_items")
}

/// 月結（RES-032 §5.4 B-3）。一個月份一列；status=closed 時該月交易的金額、日期、歸屬唯讀。
/// 可加註、可補憑證（Owner 決策 2026-09-25：可加註不可改金額）。解鎖要填原因並留在 log。
model OperatingPeriod {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// YYYY-MM
  period      String
  status      String    @default("open")
  closedBy    String?   @map("closed_by")
  closedAt    DateTime? @map("closed_at")
  /// 鎖定當下的檢查結果快照
  checklist   Json      @default("[]")
  /// [{ at, by, action: 'close'|'reopen', reason }]
  log         Json      @default("[]")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, period], map: "operating_periods_workspace_period_key")
  @@map("operating_periods")
}

/// 薪資試算草稿。runtime 自己就說「只更新本頁示例試算，不付款」——
/// 這張表保存的是那份試算，不是薪資發放紀錄，也不產生任何應付義務。
model OperatingPayrollDraft {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorKey    String   @map("actor_key")
  baseAmount  Int      @default(0) @map("base_amount")
  overtime    Int      @default(0)
  milestone   Int      @default(0)
  separate    Boolean  @default(false)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, actorKey], map: "operating_payroll_actor_key")
  @@map("operating_payroll_drafts")
}

// ─── 文件庫與文件物件（PLN-074 M6）──────────────────────────────────────────

/// 文件庫檔案。版本陣列存 Json，bytes 不在這裡 —— 走 R2，只留 objectKey。
model OperatingLibraryFile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  workbenchRef String?  @map("workbench_ref")
  name         String
  category     String   @default("material")
  tags         String   @default("")
  /// team = 公司文件庫；personal = 私人文件，只有作者讀得到
  space        String   @default("team")
  authorKey    String?  @map("author_key")
  /// [{ id, name, type, text, objectKey, bytes, at }]
  /// 文字檔內容留在 text（小、且讓搜尋可用）；二進位檔只留 objectKey。
  versions     Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, space], map: "operating_library_files_workspace_space_idx")
  @@index([workspaceId, workbenchRef], map: "operating_library_files_ref_idx")
  @@map("operating_library_files")
}

/// 日誌裡召喚出來的結構化文件物件（會議紀錄、訪談稿之類）。
model OperatingDocObject {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  workbenchRef String?  @map("workbench_ref")
  kind         String
  subKind      String?  @map("sub_kind")
  title        String
  /// 系統自動命名；使用者改過標題後關閉
  titleAuto    Boolean  @default(true) @map("title_auto")
  onDate       DateTime? @map("on_date") @db.Date
  authorKey    String?  @map("author_key")
  /// { collapsed, secs: [{ title, blocks }] } —— 區段形狀仍在演進
  payload      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, onDate], map: "operating_doc_objects_workspace_date_idx")
  @@index([workspaceId, workbenchRef], map: "operating_doc_objects_ref_idx")
  @@map("operating_doc_objects")
}

/// 日誌右欄「今日脈絡」的一列事件（PLN-074 M7）。
///
/// 一筆事件一列，不是「一天一列」：一天一列的話，兩個席位同一天各做一件事就會
/// 互相覆蓋整天的脈絡，最後只留下後寫的那個人。逐列之後，兩個人的動作自然合流成
/// 同一條時間軸，跨裝置合併也只需要比對列，不必處理陣列的合併。
///
/// kind：start＝開始一天、close＝收工、act＝其他動作（召喚物件、留言、發出請求…）。
/// 「開始一天」「收工」不另外開表：它們本來就是這條時間軸上的兩個事件，
/// 拆出去只會讓同一件事有兩個真相。
model OperatingDayLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  workbenchRef String?  @map("workbench_ref")
  onDate       DateTime @map("on_date") @db.Date
  /// Profile.id；對不到人時留空，身分仍由 actorKey 保住
  actorId      String?  @map("actor_id") @db.Uuid
  /// 席位字串（yz / lily）。工作台顯示與著色看的是這個
  actorKey     String?  @map("actor_key")
  /// 工作台顯示用的時間字串（'10:20'）
  atTime       String   @map("at_time")
  /// start | close | act
  kind         String   @default("act")
  text         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([workspaceId, onDate], map: "operating_day_logs_workspace_date_idx")
  @@index([workspaceId, workbenchRef], map: "operating_day_logs_ref_idx")
  @@map("operating_day_logs")
}

/// 日誌裡標記的「今日議題」（PLN-074 M7）。
///
/// 議題的 id 被寫回日誌 block 的 `today` 欄位，而 block 本來就存得住。
/// 少了這張表，重新整理之後 block 還指著一個已經不存在的議題，
/// 已完成的標籤就跟著消失 —— 看起來像標記沒被記住，其實是被指到的那一頭不見了。
model OperatingTodayIssue {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  workbenchRef String?   @map("workbench_ref")
  /// Profile.id；對不到人時留空，身分仍由 authorKey 保住
  authorId     String?   @map("author_id") @db.Uuid
  authorKey    String?   @map("author_key")
  /// 議題目前掛在哪一天（延後會往後移）
  onDate       DateTime  @map("on_date") @db.Date
  /// 日誌裡那一行的 block id
  blockId      String?   @map("block_id")
  text         String
  /// 標記的時刻與完成的時刻。存 timestamp 而不是 epoch 數字：
  /// 工作台要的是毫秒，但把毫秒存成 BIGINT 之後，JSON 序列化會在 BigInt 上炸掉，
  /// 而且查帳時看到的是一串數字。轉換留在邊界上做，欄位本身保持可讀。
  flaggedAt    DateTime? @map("flagged_at")
  doneAt       DateTime? @map("done_at")
  /// 延後過幾次；>0 時隔天日誌開頭會出現「從昨天帶來」
  deferred     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, onDate], map: "operating_today_issues_workspace_date_idx")
  @@index([workspaceId, workbenchRef], map: "operating_today_issues_ref_idx")
  @@map("operating_today_issues")
}

/// 營運工作台的命令紀錄（PLN-074 M7）。
///
/// 為什麼不寫 operating_audit_events：那張表是 teamcollab 的高風險稽核目錄，
/// CHECK constraint 只允許 workspace.created 這類具名動作，且強制 module_key='work'、
/// risk_level='HIGH'、human_approval_required=true。工作台的一般命令塞不進去，
/// 而把它們硬塞或乾脆不記錄都是錯的答案 —— 前者污染高風險目錄，後者讓每一次寫入都無跡可循。
///
/// 這張表同時是冪等的依據：client_ref_hash 唯一，重送同一個 clientRef 不會二次套用。
model OperatingCommandLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  /// clientRef 的 SHA256。存雜湊而不是原值：它由客戶端生成，不該原樣落進資料庫。
  clientRefHash  String   @map("client_ref_hash")
  actorProfileId String?  @map("actor_profile_id") @db.Uuid
  actorKey       String?  @map("actor_key")
  op             String
  /// 稽核顯示用的中文物種名與這一筆的名字
  entity         String
  label          String
  /// 這次命令碰到的集合，查帳時用來定位
  collections    String[]
  changeCount    Int      @default(0) @map("change_count")
  /// low | high —— 帳務集合的變更要與一般編輯分得開
  riskLevel      String   @default("low") @map("risk_level")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, clientRefHash], map: "operating_command_log_client_ref_key")
  @@index([workspaceId, createdAt], map: "operating_command_log_workspace_time_idx")
  @@index([workspaceId, riskLevel, createdAt], map: "operating_command_log_risk_idx")
  @@map("operating_command_logs")
}

model TimeSpine {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  workspace   Workspace  @relation("WorkspaceTimeSpine", fields: [workspaceId], references: [id], onDelete: Cascade)
  onDate      DateTime   @map("on_date") @db.Date
  track       SpineTrack
  refTable    String     @map("ref_table")
  refId       String     @map("ref_id") @db.Uuid
  title       String
  actorIds    String[]   @map("actor_ids") @db.Uuid
  /// 佔用強度，餵 heatmap 與衝期規則
  weight      Int        @default(1)
  state       SpineState @default(PLANNED)
  star        Boolean    @default(false)
  projectId   String?    @map("project_id") @db.Uuid
  derivedFrom String?    @map("derived_from")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([refTable, refId, onDate], map: "time_spine_ref_key")
  @@index([workspaceId, onDate], map: "time_spine_workspace_date_idx")
  @@index([workspaceId, track, onDate], map: "time_spine_workspace_track_idx")
  @@map("time_spine")
}
