model ProjectPhaseNode {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String                 @map("project_id") @db.Uuid
  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase      ProjectPhase
  label      String
  workbenchRef String? @map("workbench_ref")

  startDate  DateTime               @map("start_date")
  endDate    DateTime               @map("end_date")
  status     ProjectPhaseNodeStatus @default(UPCOMING)
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  // ── 期（PLN-075 S2 · Migration ②）────────────────────────────────────────
  /// 這個階段屬於哪一期。**必須可空**：v5 工作台的 `phases` 集合會繼續寫入
  /// 沒有期的階段列，設成必填會讓既有寫入路徑當場壞掉（PLN-075 §S2 不可觸碰）。
  phaseCycleId String?            @map("phase_cycle_id") @db.Uuid
  phaseCycle   ProjectPhaseCycle? @relation("PhaseCycleStages", fields: [phaseCycleId], references: [id], onDelete: SetNull)
  /// 期內順序（1,2,3…）。stageKind 可以重複（一期內「執行→驗收→執行→驗收」），
  /// 所以階段在期內的身分是 ordinal 而不是 stageKind。
  ordinal      Int?
  /// 五格流程的種類。既有的 `phase`（ProjectPhase enum）是另一套詞彙，
  /// 仍被 `Project.phase` 與工作台使用，不動它。
  stageKind    ProjectStageKind?  @map("stage_kind")

  milestones ProjectMilestone[]

  @@index([projectId, startDate], map: "project_phase_nodes_project_start_idx")
  @@index([phaseCycleId, ordinal], map: "project_phase_nodes_cycle_ordinal_idx")
  @@map("project_phase_nodes")
}

model ProjectMilestone {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phaseNodeId String                  @map("phase_node_id") @db.Uuid
  phaseNode   ProjectPhaseNode        @relation(fields: [phaseNodeId], references: [id], onDelete: Cascade)
  title       String
  workbenchRef String? @map("workbench_ref")

  /// 可為空＝日期待補（由 delivery[] 轉來的里程碑），不進日曆。
  /// 原本是 NOT NULL，但工作台一直允許「先立下要交付什麼，日期之後再說」，
  /// 逼一個假日期進來會讓那些里程碑出現在日曆上。
  date        DateTime?
  status      ProjectMilestoneStatus  @default(UPCOMING)
  acceptance  String?
  derivedFrom String?                 @map("derived_from")
  remind      String?
  /// 里程碑獎金（P3）。0＝這個里程碑不帶獎金。
  /// 有了它，人事頁那一格才是算出來的；在這之前它是 payroll 草稿裡手打的數字。
  bonusAmount Int                     @default(0) @map("bonus_amount")

  /// 交付夾（INTEGRATION-DECISION §5）：`20260411_M04_網站資源一版/` 成為 M04 的交付夾。
  /// 這是**連結**，不是包含 —— 資料夾不會被搬進里程碑，刪掉里程碑也不該動到檔案。
  folderId    String?                 @map("folder_id") @db.Uuid
  folder      ProjectFolder?          @relation("MilestoneFolder", fields: [folderId], references: [id], onDelete: SetNull)

  objectives  ProjectObjective[]
  tasks       ProjectTask[]           @relation("MilestoneTasks")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  @@index([phaseNodeId, date], map: "project_milestones_phase_node_date_idx")
  @@index([folderId], map: "project_milestones_folder_idx")
  @@map("project_milestones")
}

