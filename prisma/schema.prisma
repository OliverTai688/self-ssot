model ProjectTask {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objectiveId String?        @map("objective_id") @db.Uuid
  objective   ProjectObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  title       String
  body        String?
  status      TaskStatus     @default(TODO)
  visibility  VisibilityType @default(INTERNAL_ONLY)
  priority    Int            @default(2)
  source      TaskSource     @default(MANUAL)
  dueAt       DateTime?      @map("due_at")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // ── 營運工作台欄位（SCH-008 §4）──────────────────────────────────────────
  /// 工作台的原始狀態字串（Todo / Doing / Review / Done）。TaskStatus 沒有 REVIEW，
  /// 而把 Review 併進 IN_PROGRESS 會讓工作台顯示的狀態在往返後改變，所以原值另存一欄。
  operatingStatus String? @map("operating_status")
  /// S / M / L，餵 Throughput 與 Cycle Time 的樣本分組
  sizeClass       String? @map("size_class")
  blocker         String?
  /// 「做完長什麼樣」——驗收判準，不是描述
  expectation     String?
  evidenceCount   Int     @default(0) @map("evidence_count")
  /// [{ ty, id, t }]：wait / block / doc 等關聯。形狀仍在演進，先不正規化。
  relations       Json    @default("[]")
  /// { 交付形式: "PR + 測試", … } 自訂欄位
  customFields    Json    @default("{}") @map("custom_fields")
  /// 純文字子項；升級成正式 Task 之前不需要自己的列
  subtasks        Json    @default("[]")

  workbenchRef String? @map("workbench_ref")

  // ── 審核任務（PLN-075 S2 · Migration ②）──────────────────────────────────
  /// TODO 與審核是同一張表的兩種 kind，不是兩張表：兩張表的話
  /// 「這個里程碑還剩幾件事」必須 UNION 兩個來源，於是會有兩個答案。
  kind         ProjectTaskKind     @default(TODO)
  /// kind = REVIEW 才有意義。Profile.id；對不到人時留空，身分仍由 reviewerKey 保住
  /// （抄 OperatingComment 的雙身分設計）。刻意不加外鍵，與 OperatingDayLog.actorId 一致。
  reviewerId   String?             @map("reviewer_id") @db.Uuid
  /// 席位字串（yz / lily）。工作台送上來的是席位，不是 uuid。
  reviewerKey  String?             @map("reviewer_key")
  reviewResult ProjectReviewState? @map("review_result")
  reviewedAt   DateTime?           @map("reviewed_at")
  reviewNote   String?             @map("review_note")

  /// 直接掛在哪個里程碑。objectiveId 仍然存在（更細的分組），但不再是必要的中間層：
  /// 「里程碑底下的 TODO」不該被迫先發明一個目標。
  milestoneId  String?             @map("milestone_id") @db.Uuid
  milestone    ProjectMilestone?   @relation("MilestoneTasks", fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([projectId, kind, status], map: "project_tasks_project_kind_status_idx")
  @@index([milestoneId, kind], map: "project_tasks_milestone_kind_idx")
  @@map("project_tasks")
}

